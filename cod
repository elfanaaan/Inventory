function setUserPassword(
  userCode,
  newPassword
) {

  const sheet =
    getSheet('المستخدمون');

  userCode =
    clean(userCode);

  newPassword =
    String(newPassword || '');

  if (!userCode) {

    throw new Error(
      'كود المستخدم مطلوب.'
    );
  }

  if (
    newPassword.length < 6
  ) {

    throw new Error(
      'كلمة المرور يجب ألا تقل عن 6 أحرف أو أرقام.'
    );
  }

  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {

    throw new Error(
      'لا يوجد مستخدمون في النظام.'
    );
  }

  const users =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        10
      )
      .getValues();

  for (
    let i = 0;
    i < users.length;
    i++
  ) {

    if (
      clean(users[i][0]) !==
      userCode
    ) {
      continue;
    }

    const salt =
      generateSalt();

    const hash =
      createPasswordHash(
        newPassword,
        salt
      );

    const rowNumber =
      i + 2;

    sheet
      .getRange(
        rowNumber,
        3
      )
      .setValue(salt);

    sheet
      .getRange(
        rowNumber,
        4
      )
      .setValue(hash);

    sheet
      .getRange(
        rowNumber,
        8
      )
      .setValue('لا');

    sheet
      .getRange(
        rowNumber,
        10
      )
      .setValue(now());

    return {

      success:
        true,

      userCode:
        userCode

    };
  }

  throw new Error(
    'لم يتم العثور على المستخدم: ' +
    userCode
  );
}

