function createTransferUnlocked(data, token) {

  data =
    data || {};
  var session = validateSession(token);
  if (['مدير النظام','مدير','admin','ADMIN'].indexOf(clean(session.role)) < 0 && clean(session.branchCode) && clean(data.fromBranch) !== clean(session.branchCode)) throw new Error('لا يمكنك إنشاء تحويل من فرع آخر.');
  if (session.userName) data.requestedBy = session.userName;

  const sheet =
    getSheet('التحويلات');

  const fromBranch =
    clean(data.fromBranch);

  const toBranch =
    clean(data.toBranch);

  const itemCode =
    clean(data.itemCode);

  const quantity =
    toNumber(data.quantity);

  const requestedBy =
    clean(data.requestedBy);

  // تتبّع التاريخ الذي وصل من الواجهة، ثم تثبيت اليوم المحلي دون تفسيره كتوقيت UTC.
  var receivedTransferDate = clean(data.date);
  console.log('[TRANSFER_DATE_TRACE] received=' + JSON.stringify(data.date) +
    ' | from=' + fromBranch + ' | to=' + toBranch + ' | item=' + itemCode);
  if (!receivedTransferDate) {
    throw new Error('لم يصل تاريخ الجرد إلى الخادم. لم يتم إنشاء التحويل؛ أعد اختيار تاريخ الجرد ثم حاول مرة أخرى.');
  }
  var transferDate;
  var isoDateMatch = receivedTransferDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (isoDateMatch) {
    transferDate = new Date(Number(isoDateMatch[1]), Number(isoDateMatch[2]) - 1, Number(isoDateMatch[3]));
  } else {
    transferDate = new Date(data.date);
    if (!isNaN(transferDate.getTime())) {
      var normalizedKey = Utilities.formatDate(transferDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
      var parts = normalizedKey.split('-');
      transferDate = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
    }
  }
  if (!transferDate || isNaN(transferDate.getTime())) throw new Error('تاريخ التحويل غير صحيح: ' + receivedTransferDate);
  transferDate.setHours(12, 0, 0, 0);
  var savedTransferDateKey = Utilities.formatDate(transferDate, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  console.log('[TRANSFER_DATE_TRACE] normalized=' + savedTransferDateKey + ' | timezone=' + Session.getScriptTimeZone());

  const transferType =
    clean(data.transferType) ||
    'فرع → فرع';

  const reason =
    clean(data.reason);

  if (!fromBranch) {

    throw new Error(
      'يجب تحديد الفرع المحوّل.'
    );
  }

  if (!itemCode) {

    throw new Error(
      'يجب تحديد الصنف.'
    );
  }

  if (quantity <= 0) {

    throw new Error(
      'الكمية يجب أن تكون أكبر من صفر.'
    );
  }

  {
    // Check the inventory snapshot for the transfer date, not the current date.
    // A later inventory must never erase the available balance of an earlier day.
    var datedInventory = getBranchDailyInventory(fromBranch, savedTransferDateKey, token);
    var balanceItem = (datedInventory.rows || []).find(function(x) {
      return clean(x.itemCode) === itemCode;
    });
    if (!balanceItem) throw new Error('الصنف غير موجود في جرد الفرع بتاريخ التحويل.');
    var availableBalance = toNumber(balanceItem.ending);
    console.log('[TRANSFER_BALANCE_TRACE] ' + JSON.stringify({
  branch: fromBranch,
  item: itemCode,
  date: savedTransferDateKey,
  balanceItem: balanceItem || null,
  allMatchingRows: (datedInventory.rows || []).filter(function(x) {
    return clean(x.itemCode) === itemCode;
  })
}));
    // Pending transfers reserve stock, but only up to the requested date.
    // Later transfers must not block a historical transfer.
    var pendingReserved = getTransfers().reduce(function(sum, t) {
      var tType = clean(t['نوع التحويل']) || 'فرع → فرع';
      var status = clean(t['الحالة']);
      var tDate = transferDateKey_(t['التاريخ']);
      return sum + (clean(t['الفرع المحوّل']) === fromBranch &&
        clean(t['كود الصنف']) === itemCode &&
        (status === 'قيد الانتظار' || status === 'معلق') &&
        tType === 'فرع → فرع' && tDate && tDate <= savedTransferDateKey
        ? toNumber(t['الكمية']) : 0);
    }, 0);
    var transferable = availableBalance - pendingReserved;
    if (transferable < quantity) {
      throw new Error('لا يمكن إنشاء التحويل بتاريخ ' + savedTransferDateKey +
        '. رصيد آخر: ' + availableBalance +
        '، المحجوز في تحويلات معلّقة: ' + pendingReserved +
        '، المتاح: ' + Math.max(0, transferable) + '.');
    }
  }

  if (
    transferType ===
    'فرع → فرع'
  ) {

    if (!toBranch) {

      throw new Error(
        'يجب تحديد الفرع المستلم.'
