function getBranches() {
  var cache = CacheService.getScriptCache(), key = 'inventory_branches_v2';
  try { var cached = cache.get(key); if (cached) { var parsed = JSON.parse(cached); if (Array.isArray(parsed)) return parsed; } } catch (e) {}
  var sheet = getSheet('الفروع');
  if (sheet.getLastRow() < 2) return [];
  var rows = sheet.getRange(2, 1, sheet.getLastRow() - 1, sheet.getLastColumn()).getValues();
  try { cache.put(key, JSON.stringify(rows), 90); } catch (e) {}
  return rows;
}
function getBranchesForUI() {
  return getBranches().map(function(r) {
    return { code: clean(r[0]), name: clean(r[1]), status: clean(r[2]) || 'نشط', entityType: clean(r[4]) || 'فرع' };
  }).filter(function(b) { return b.code && b.name && b.status === 'نشط'; });
}
function dailyAutoCloseBranchMatches_(value, branch) {
  value = clean(value);
  return value === clean(branch.code) ||
         value === clean(branch.name);
}
function dailyAutoCloseIsPending_(branch, targetDate) {
  var targetKey = dateKey(targetDate);

  return getTransfers().some(function(t) {
    var transferDate = transferDateKey_(t['التاريخ']);
    var status = clean(t['الحالة']);

    if (transferDate !== targetKey) return false;
    if (status !== 'قيد الانتظار' && status !== 'معلق') return false;

    return dailyAutoCloseBranchMatches_(t['الفرع المحوّل'], branch) ||
           dailyAutoCloseBranchMatches_(t['الفرع المستلم'], branch);
  });
}
function isDailyInventoryDayCompleteForAutoClose_(branch, targetDate) {
  if (dailyAutoCloseIsPending_(branch, targetDate)) return false;

  var targetKey = dateKey(targetDate);
  var items = getItemsForUI();
  if (!items.length) return false;
  var records = getSheetObjects('الجرد اليومي');
  var recordMap = {};

  records.forEach(function(r) {
    if (clean(r['كود الفرع']) !== clean(branch.code)) return;

    var d;
    try {
      d = dateKey(r['التاريخ']);
    } catch (e) {
      return;
    }

    if (d !== targetKey) return;

    var code = clean(r['كود الصنف']);
    if (code) recordMap[code] = r;
  });

  return items.every(function(item) {
    var rec = recordMap[clean(item.code)];
    return rec &&
      rec['الجرد الفعلي'] !== '' &&
      rec['الجرد الفعلي'] != null;
  });
}
function dailyAutoCloseIsEligible_(targetDate) {
  var date = dateOnly(targetDate);
  if (isNaN(date.getTime())) return false;

  date.setDate(date.getDate() + 3);

  return new Date() >= date;
}


function autoCloseCompletedDailyInventoryDays() {
  var branches = getBranchesForUI();
  var today = dateOnly(new Date());
  var closedCount = 0;
  var errors = [];

  branches.forEach(function(branch) {
    for (var daysAgo = 1; daysAgo <= 30; daysAgo++) {
      var targetDate = new Date(today);
      targetDate.setDate(targetDate.getDate() - daysAgo);

      if (!dailyAutoCloseIsEligible_(targetDate)) continue;

      try {
        var lockState = getDailyLockStateRecord_(
          branch.code,
          targetDate
        );

        if (lockState) {
          if (
            lockState.status === 'مفتوح إداريًا' ||
            lockState.status === 'مفتوح' ||
            lockState.status === 'مغلق'
          ) continue;
        }

        if (
          !isDailyInventoryDayCompleteForAutoClose_(
            branch,
            targetDate
          )
        ) continue;

        var reason =
          'إغلاق تلقائي بعد اكتمال الجرد ومرور 48 ساعة من نهاية اليوم';

        // تسجيل التدقيق أولًا.
        writeAutomaticDailyCloseAudit_(
          branch.code,
          targetDate,
          reason
        );

        // تسجيل حالة الإغلاق بعد نجاح التدقيق.
        var sheet = getSheet('الإعدادات');

        sheet.appendRow([
          dailyLockKey_(branch.code, targetDate),
          'مغلق',
          reason + ' | النظام | ' + now()
        ]);

        closedCount++;

      } catch (e) {
        var errorMessage = String(e.message || e);

        errors.push({
          branch: clean(branch.name),
          date: dateKey(targetDate),
          error: errorMessage
        });

        try {
          writeAutomaticDailyCloseError_(
            branch.code,
            targetDate,
            errorMessage
          );
        } catch (auditError) {
          errors.push({
            branch: clean(branch.name),
            date: dateKey(targetDate),
            error: 'تعذر تسجيل الخطأ: ' +
              String(auditError.message || auditError)
          });
        }
      }
    }
  });

  return {
    success: errors.length === 0,
    closedCount: closedCount,
    errors: errors
  };
}


function testDailyAutoCloseReadOnly() {
  var props = PropertiesService.getScriptProperties();
  var propKey = 'DAILY_AUTO_CLOSE_TEST_PROGRESS';
  var state = null;

  try {
    state = JSON.parse(props.getProperty(propKey) || 'null');
  } catch (e) {}

  if (!state || state.completed) {
    state = {
      index: 0,
      completed: false,
      counts: {
        eligibleDays: 0,
        alreadyClosed: 0,
        administrativelyReopened: 0,
        pendingTransferDays: 0,
        incompleteDays: 0,
        errors: 0
      },
      samples: {
        eligibleDays: [],
        alreadyClosed: [],
        administrativelyReopened: [],
        pendingTransferDays: [],
        incompleteDays: [],
        errors: []
      }
    };
  }

  var branches = getBranchesForUI();
  var items = getItemsForUI();
  var transfers = getTransfers();
  var records = getSheetObjects('الجرد اليومي');

  var today = dateOnly(new Date());
  var candidates = [];

  branches.forEach(function(branch) {
    for (var daysAgo = 1; daysAgo <= 30; daysAgo++) {
      var d = new Date(today);
      d.setDate(d.getDate() - daysAgo);

      if (dailyAutoCloseIsEligible_(d)) {
        candidates.push({
          branch: branch,
          date: d,
          key: dateKey(d)
        });
      }
    }
  });

  // قراءة آخر حالات الإغلاق مرة واحدة.
  var lockMap = {};
  var settings = getSheet('الإعدادات');

  if (settings.getLastRow() >= 2 && settings.getLastColumn() >= 2) {
    var settingsValues = settings.getRange(
      2, 1,
      settings.getLastRow() - 1,
      Math.min(3, settings.getLastColumn())
    ).getValues();

    settingsValues.forEach(function(r) {
      var key = clean(r[0]);
      if (key) {
        lockMap[key] = {
          status: clean(r[1]),
          reason: clean(r[2])
        };
      }
    });
  }

  // تجهيز أسماء وأكواد الفروع.
  var branchAliases = {};

  branches.forEach(function(b) {
    branchAliases[clean(b.code)] = clean(b.code);
    branchAliases[clean(b.name)] = clean(b.code);
  });

  // تجهيز التحويلات المعلقة مرة واحدة.
  var pendingMap = {};

  transfers.forEach(function(t) {
    var status = clean(t['الحالة']);
    if (status !== 'قيد الانتظار' && status !== 'معلق') return;

    var d;
    try {
      d = transferDateKey_(t['التاريخ']);
    } catch (e) {
      return;
    }

    [
      t['الفرع المحوّل'],
      t['الفرع المستلم']
    ].forEach(function(value) {
      var code = branchAliases[clean(value)];
      if (code) pendingMap[code + '|' + d] = true;
    });
  });

  // تجهيز سجلات الجرد مرة واحدة.
  var inventoryMap = {};

  records.forEach(function(r) {
    var branchCode = clean(r['كود الفرع']);
    var itemCode = clean(r['كود الصنف']);

    if (!branchCode || !itemCode) return;

    var d;
    try {
      d = dateKey(r['التاريخ']);
    } catch (e) {
      return;
    }

    inventoryMap[
      branchCode + '|' + d + '|' + itemCode
    ] = r['الجرد الفعلي'];
  });

  function addResult(type, branch, date, message) {
    state.counts[type]++;

    if (state.samples[type].length < 10) {
      state.samples[type].push({
        branch: branch.name,
        date: date,
        error: message || ''
      });
    }
  }

  var batchSize = 8;
  var end = Math.min(
    state.index + batchSize,
    candidates.length
  );

  for (var i = state.index; i < end; i++) {
    var candidate = candidates[i];
    var branch = candidate.branch;
    var date = candidate.key;

    try {
      var lockKey = dailyLockKey_(
        branch.code,
        candidate.date
      );

      var lock = lockMap[lockKey];

      if (lock && lock.status === 'مفتوح إداريًا') {
        addResult('administrativelyReopened', branch, date);
        continue;
      }

      if (lock && lock.status === 'مغلق') {
        addResult('alreadyClosed', branch, date);
        continue;
      }

      if (lock && lock.status === 'مفتوح') continue;

      if (pendingMap[clean(branch.code) + '|' + date]) {
        addResult('pendingTransferDays', branch, date);
        continue;
      }

      var complete = items.length > 0;

      for (var j = 0; j < items.length; j++) {
        var itemKey =
          clean(branch.code) + '|' +
          date + '|' +
          clean(items[j].code);

        var actual = inventoryMap[itemKey];

        if (actual === undefined || actual === null || actual === '') {
          complete = false;
          break;
        }
      }

      if (complete) {
        addResult('eligibleDays', branch, date);
      } else {
        addResult('incompleteDays', branch, date);
      }

    } catch (e) {
      addResult(
        'errors',
        branch,
        date,
        String(e.message || e)
      );
    }
  }

  state.index = end;
  state.completed = end >= candidates.length;

  props.setProperty(propKey, JSON.stringify(state));

  var result = {
    success: state.counts.errors === 0,
    completed: state.completed,
    processed: state.index,
    total: candidates.length,
    counts: state.counts,
    samples: state.samples
  };

  Logger.log(JSON.stringify(result, null, 2));
  return result;
}


function installDailyAutoCloseTrigger() {
  var handler = 'autoCloseCompletedDailyInventoryDays';

  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (trigger.getHandlerFunction() === handler) {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  ScriptApp.newTrigger(handler)
    .timeBased()
    .everyHours(1)
    .create();

  return { success: true, message: 'تم إعداد فحص الإغلاق التلقائي كل ساعة.' };
}
function stopDailyAutoCloseTrigger() {
  var handler = 'autoCloseCompletedDailyInventoryDays';
  var deleted = 0;

  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (trigger.getHandlerFunction() === handler) {
      ScriptApp.deleteTrigger(trigger);
      deleted++;
    }
  });

  return {
    success: true,
    deletedTriggers: deleted,
    message: 'تم إيقاف مشغل الإغلاق التلقائي مؤقتًا.'
  };
}
