/**
 * مزامنة آمنة للكتالوج المعتمد:
 * - تطابق الصنف بالاسم، لا بالاسم والوحدة، لتجنب النسخ المكررة.
 * - الأصناف الموجودة تحتفظ بالكود والوحدة والحالة والترتيب والتاريخ.
 * - يصحح التصنيف وفق القائمة المعتمدة ويضيف الأصناف الناقصة فقط.
 * - لا يحذف أي صنف أو سجل تاريخي.
 * تُستدعى من لوحة الإدارة، ولا تنفذ إلا لمدير النظام.
 */

function syncApprovedItemCatalog(token) {
  requireSystemManagerSession(token);
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var itemsSheet = getSheet('الأصناف');
    var headers = itemsSheet.getRange(1, 1, 1, itemsSheet.getLastColumn()).getDisplayValues()[0].map(clean);
    var codeCol = zenobiaHeaderIndex_(headers, ['كود الصنف','كود المنتج','رمز الصنف','كود'], 0) + 1;
    var nameCol = zenobiaHeaderIndex_(headers, ['اسم الصنف','اسم المنتج','الصنف','المنتج'], 1) + 1;
    var unitCol = zenobiaHeaderIndex_(headers, ['الوحدة','وحدة القياس','وحدة الصنف'], 2) + 1;
    var categoryCol = zenobiaHeaderIndex_(headers, ['التصنيف','الفئة','تصنيف الصنف'], 3) + 1;
    var orderCol = zenobiaHeaderIndex_(headers, ['ترتيب العرض','الترتيب','ترتيب الصنف'], 4) + 1;
    var statusCol = zenobiaHeaderIndex_(headers, ['الحالة','حالة الصنف','حالة التنشيط'], 5) + 1;
    var createdCol = zenobiaHeaderIndex_(headers, ['تاريخ الإنشاء'], 6) + 1;
    if (!itemsSheet.getLastColumn() || !nameCol || !unitCol || !categoryCol) throw new Error('تعذر تحديد أعمدة ورقة الأصناف.');
    var last = itemsSheet.getLastRow(), rows = last >= 2 ? itemsSheet.getRange(2,1,last-1,itemsSheet.getLastColumn()).getValues() : [];
    var byName = {}, maxCode = 0, maxOrder = 0;
    rows.forEach(function(r,i){
      var name = clean(r[nameCol-1]); if (name) { if (!byName[name]) byName[name] = []; byName[name].push({row:i+2,values:r}); }
      var m = clean(r[codeCol-1]).match(/^ITM-(\d+)$/i); if (m) maxCode = Math.max(maxCode, Number(m[1]));
      maxOrder = Math.max(maxOrder, toNumber(r[orderCol-1]));
    });
    var added = 0, recategorized = 0, duplicatesSkipped = 0;
    SOURCE_CENTRAL_ITEMS.forEach(function(def){
      var name = clean(def[0]), unit = clean(def[1]), category = clean(def[2]);
      if (!name) return;
      var matches = byName[name] || [];
      if (matches.length) {
        if (matches.length > 1) duplicatesSkipped++;
        // لا نلمس إلا التصنيف؛ لا نغيّر الوحدة أو الحالة أو الكود أو الترتيب أو التاريخ.
        matches.forEach(function(match){
          var oldCategory = clean(match.values[categoryCol-1]);
          if (!oldCategory) {
            itemsSheet.getRange(match.row, categoryCol).setValue(category);
            match.values[categoryCol-1] = category;
            recategorized++;
          }
          // طلب المستخدم صراحةً أن يظهر «كنافة بالكريمة» في الجرد اليومي؛ فعّل هذا الصنف تحديدًا فقط.
          if (name === 'كنافة بالكريمة' && statusCol > 0 && clean(match.values[statusCol-1]) !== 'نشط') {
            itemsSheet.getRange(match.row, statusCol).setValue('نشط');
            match.values[statusCol-1] = 'نشط';
          }
        });
        return;
      }
      maxCode++;
      maxOrder++;
      var newRow = new Array(itemsSheet.getLastColumn()).fill('');
      newRow[codeCol-1] = 'ITM-' + String(maxCode).padStart(4,'0');
      newRow[nameCol-1] = name;
      newRow[unitCol-1] = unit;
      newRow[categoryCol-1] = category;
      if (orderCol > 0) newRow[orderCol-1] = maxOrder;
      if (statusCol > 0) newRow[statusCol-1] = 'نشط';
      if (createdCol > 0) newRow[createdCol-1] = now();
      itemsSheet.appendRow(newRow);
      byName[name] = [{row:itemsSheet.getLastRow(),values:newRow}];
      added++;
    });
    // توحيد أي بقايا للتصنيف القديم حتى الأصناف غير الموجودة في قائمة البذور، دون المساس بكود الصنف أو سجلاته.
    var currentItemLast = itemsSheet.getLastRow();
    if (currentItemLast >= 2) {
      var allCategoriesRange = itemsSheet.getRange(2, categoryCol, currentItemLast - 1, 1);
      var allCategories = allCategoriesRange.getValues();
      var aliasChanged = false;
      allCategories.forEach(function(r){ if (clean(r[0]) === 'الشرقي') { r[0] = 'الشرقى'; aliasChanged = true; } });
      if (aliasChanged) { allCategoriesRange.setValues(allCategories); recategorized++; }
    }
    // تأمين وجود ورقة التصنيفات ثم ترحيل الاسم القديم إلى الاسم المعتمد.
    var categoriesSheet = getOrCreateCategoriesSheet_();
    var categoryMap = getHeaderMap(categoriesSheet);
    var catNameCol = categoryMap['اسم التصنيف'] || categoryMap['التصنيف'] || categoryMap['الفئة'] || 1;
    var catOrderCol = categoryMap['ترتيب العرض'] || categoryMap['الترتيب'] || 2;
    var catNotesCol = categoryMap['ملاحظات'] || 0;
    var catLast = categoriesSheet.getLastRow();
    if (catLast >= 2) {
      var catValues = categoriesSheet.getRange(2,1,catLast-1,categoriesSheet.getLastColumn()).getValues();
      var canonicalRow = 0, legacyRows = [];
      catValues.forEach(function(r,idx){ var n=clean(r[catNameCol-1]); if(n==='الشرقى') canonicalRow=idx+2; if(n==='الشرقي') legacyRows.push(idx+2); });
      if (!canonicalRow && legacyRows.length) {
        canonicalRow = legacyRows.shift();
        categoriesSheet.getRange(canonicalRow,catNameCol).setValue('الشرقى');
      }
      // عند وجود الاسمين معًا، ادمج الملاحظات في التصنيف المعتمد ثم أزل صف التصنيف القديم فقط.
      legacyRows.sort(function(a,b){return b-a;}).forEach(function(oldRow){
        if (canonicalRow && catNotesCol) {
          var oldNote=clean(categoriesSheet.getRange(oldRow,catNotesCol).getDisplayValue());
          var currentNote=clean(categoriesSheet.getRange(canonicalRow,catNotesCol).getDisplayValue());
          if(oldNote && oldNote!==currentNote) categoriesSheet.getRange(canonicalRow,catNotesCol).setValue(currentNote ? currentNote+' | '+oldNote : oldNote);
        }
        categoriesSheet.deleteRow(oldRow);
        if(oldRow<canonicalRow) canonicalRow--;
      });
    }
    // التأكد من وجود جميع التصنيفات المعتمدة حتى لو لم يكن هناك صنف جديد في أحدها.
    ['الشرقى','التورت','منتجات رمضان','الجاتوه','أنجليش كيك','جاتوه سواريه','شيكولاتة','الكعك','البيتي فور والبسكويت والغريبة','مخبوزات','آيس كريم','الشمع'].forEach(ensureCategoryExists_);
    SpreadsheetApp.flush();
    invalidateInitialDataCache();
    return {success:true,added:added,recategorized:recategorized,duplicateNames:duplicatesSkipped,message:'تمت مزامنة القائمة المعتمدة دون حذف سجلات تاريخية أو تغيير وحدات الأصناف الموجودة.'};
  } finally { lock.releaseLock(); }
}



