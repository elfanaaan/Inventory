    getSheet('الحركات');

  const branchCode =
    clean(data.branchCode);

  const itemCode =
    clean(data.itemCode);

  const type =
    clean(data.type);

  const quantity =
    toNumber(data.quantity);

  const reference =
    clean(data.reference);

  const party =
    clean(data.party);

  const notes =
    clean(data.notes);

  const createdBy =
    clean(data.createdBy);

  if (!branchCode) {

    throw new Error(
      'كود الفرع مطلوب للحركة.'
    );
  }

  if (!itemCode) {

    throw new Error(
      'كود الصنف مطلوب للحركة.'
    );
  }

  if (!type) {

    throw new Error(
      'نوع الحركة مطلوب.'
    );
  }

  if (quantity <= 0) {

    throw new Error(
      'كمية الحركة يجب أن تكون أكبر من صفر.'
    );
  }

  const map =
    getHeaderMap(sheet);

  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getValues()[0];

  const row =
    new Array(
      headers.length
    ).fill('');

  row[
    map['كود الحركة'] - 1
  ] =
    generateCode('MOV');

  row[
    map['التاريخ'] - 1
  ] =
    data.date
      ? dateOnly(data.date)
      : now();

  row[
    map['كود الفرع'] - 1
  ] =
    branchCode;

  row[
    map['كود الصنف'] - 1
  ] =
    itemCode;

  row[
    map['نوع الحركة'] - 1
  ] =
    type;

  row[
    map['الكمية'] - 1
  ] =
    quantity;

  row[
    map['المرجع'] - 1
  ] =
    reference;

  if (map['الجهة']) {

    row[
      map['الجهة'] - 1
    ] =
      party;
  }

  if (map['الملاحظات']) {

    row[
      map['الملاحظات'] - 1
    ] =
      notes;
  }

  if (map['منشئ الحركة']) {

    row[
      map['منشئ الحركة'] - 1
    ] =
      createdBy;
  }

  if (map['وقت الإنشاء']) {

    row[
      map['وقت الإنشاء'] - 1
    ] =
      now();
  }

  if (map['الحالة']) {

    row[
      map['الحالة'] - 1
    ] =
      'مرحل';
  }

  sheet.appendRow(row);

  return {

    success:
      true,

    code:
      row[
        map['كود الحركة'] - 1
      ]

  };
}

