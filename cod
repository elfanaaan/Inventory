function getDailyInventoryTable(params) {

  params =
    params || {};

  const branchCode =
    clean(params.branchCode);

  const targetDate =
    dateOnly(params.date);

  if (!branchCode) {

    throw new Error(
      'يجب تحديد الفرع.'
    );
  }

  const items =
    getItemsForUI();

  const inventoryRows =
    getInventoryRecords();

  const rows = [];

  items.forEach(function(item) {

    const previous =
      getLatestActualBefore(
        branchCode,
        item.code,
        targetDate
      );

    const existing =
      inventoryRows.find(function(row) {

        return (

          clean(row['كود الفرع']) ===
            branchCode &&

          clean(row['كود الصنف']) ===
            item.code &&

          dateKey(row['التاريخ']) ===
            dateKey(targetDate)

        );

      });

    const movements =
      calculateItemMovements(
        branchCode,
        item.code,
        targetDate,
        targetDate
      );

    const opening =
      previous
        ? previous.actual
        : 0;

    const hospitality =
      existing
        ? toNumber(
            existing['الضيافة']
          )
        : movements.hospitality;

    const sold =
      existing
        ? toNumber(
            existing['المباع']
          )
        : movements.sold;

    const expected =
      opening +
      movements.received -
      movements.returnsQty -
      hospitality +
      movements.transferIn -
      movements.transferOut;

    const ending = expected - sold;

    const actual =
      existing && existing['الجرد الفعلي'] !== '' && existing['الجرد الفعلي'] != null
        ? toNumber(existing['الجرد الفعلي'])
        : null;

    const difference =
      actual === null
        ? null
        : actual - ending;

    rows.push({

      itemCode:
        item.code,

      itemName:
        item.name,

      unit:
        item.unit,

      category:
        item.category,

      opening:
        opening,

      received:
        movements.received,

      returnsQty:
        movements.returnsQty,

      hospitality:
        hospitality,

      hospitalityTo:
        existing
          ? clean(
              existing['الضيافة إلى']
            )
          : movements.hospitalityTo,

      transferIn:
        movements.transferIn,

      transferOut:
        movements.transferOut,

      sold:
        sold,

      expected:
        expected,

      ending:
        ending,

      actual:
        actual,

      difference:
        difference,

      notes:
        existing
          ? clean(
              existing['الملاحظات']
            )
          : ''

    });
  });

  return {

    success:
      true,

    date:
      dateKey(targetDate),

    branchCode:
      branchCode,

    rows:
      rows

  };
}

function saveMovement(data) {

