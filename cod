        if(wasExisting && oldText!==newText) auditChanges.push({id:auditId,field:fieldName,oldValue:oldText,newValue:newText,item:code});
        row[index]=newValue;
      }
      trackedWrite(ixDate,'التاريخ',date); trackedWrite(ixBranch,'كود الفرع',branchCode); trackedWrite(ixItem,'كود الصنف',code);
      if (isSystemManager && ixOpening >= 0 && item.opening !== null && item.opening !== undefined && item.opening !== '') trackedWrite(ixOpening,'رصيد أول المدة',toNumber(item.opening));
      trackedWrite(ixReceived,'المستلم',toNumber(item.received)); trackedWrite(ixReturns,'المرتجعات',toNumber(item.returnsQty));
      trackedWrite(ixHospitality,'الضيافة',toNumber(item.hospitality)); trackedWrite(ixHospitalityBy,'بأمر من',clean(item.hospitalityBy)); trackedWrite(ixHospitalityTo,'لمن',clean(item.hospitalityTo));
      trackedWrite(ixSold,'المباع',toNumber(item.sold)); trackedWrite(ixActual,'الجرد الفعلي',item.actual===null||item.actual===undefined||item.actual===''?'':toNumber(item.actual)); trackedWrite(ixNotes,'الملاحظات',clean(item.notes));
      if (ixSubmittedBy >= 0) row[ixSubmittedBy] = clean(data.submittedBy);
      saved++;
    });

    if (auditChanges.length && !clean(data.changeReason || data.reason)) throw new Error('سبب التعديل إلزامي عند تغيير بيانات جرد محفوظة.');
    // تحديث الصفوف الموجودة على شكل مجموعات متجاورة، ثم إضافة الصفوف الجديدة دفعة واحدة.
    var changed = Object.keys(changedExistingRows).map(Number).sort(function(a, b) { return a - b; });
    var pos = 0;
    while (pos < changed.length) {
      var runStart = changed[pos], runEnd = runStart;
      pos++;
      while (pos < changed.length && changed[pos] === runEnd + 1) { runEnd = changed[pos]; pos++; }
      sheet.getRange(runStart + 1, 1, runEnd - runStart + 1, lastCol).setValues(values.slice(runStart, runEnd + 1));
    }
    if (values.length > originalDataLength) {
      sheet.getRange(originalDataLength + 1, 1, values.length - originalDataLength, lastCol).setValues(values.slice(originalDataLength));
    }
    auditChanges.forEach(function(c){writeAuditEntry_(session,branchCode,'تعديل تشغيلي','الجرد اليومي',c.id,c.field+': '+c.oldValue,c.field+': '+c.newValue,'الصنف: '+c.item+' | التاريخ: '+targetKeyDate+' | سبب التعديل: '+clean(data.changeReason||data.reason||'لم يُذكر'));});
    for (var nr=originalDataLength; nr<values.length; nr++) {
      var newRow=values[nr], newItemCode=clean(newRow[ixItem]);
      if (!newItemCode) continue;
      var snapshot=[];
      [[ixOpening,'رصيد أول المدة'],[ixReceived,'المستلم'],[ixReturns,'المرتجعات'],[ixHospitality,'الضيافة'],[ixSold,'المباع'],[ixActual,'الجرد الفعلي']].forEach(function(pair){if(pair[0]>=0 && newRow[pair[0]]!=='' && newRow[pair[0]]!=null)snapshot.push(pair[1]+': '+newRow[pair[0]]);});
      writeAuditEntry_(session,branchCode,'إدخال جرد جديد','الجرد اليومي',ixId>=0?newRow[ixId]:(branchCode+'|'+targetKeyDate+'|'+newItemCode),'',snapshot.join(' | '),'الصنف: '+newItemCode+' | التاريخ: '+targetKeyDate+' | سبب الإدخال: '+clean(data.changeReason||data.reason||'إدخال جديد'));
    }
    return { success: true, saved: saved, auditedChanges:auditChanges.length, message: 'تم حفظ الجرد وتسجيل التعديلات' };
  } finally {
    lock.releaseLock();
  }
}

function getInventoryReport(params, token) {
  params = params || {};
  var fromDate = dateOnly(params.fromDate || params.date);
  var toDate = dateOnly(params.toDate || params.date);
  if (isNaN(fromDate.getTime()) || isNaN(toDate.getTime())) throw new Error('حدد تاريخ بداية ونهاية صحيحين.');
  if (toDate < fromDate) throw new Error('تاريخ النهاية يجب ألا يسبق البداية.');
  var fromKey = dateKey(fromDate), toKey = dateKey(toDate);
  var branches = getBranchesForUI();
  var allItems = getItems();
  var items = params.includeInactive ? allItems : allItems.filter(function(i){return i.status === 'نشط';});
  var branchCode = clean(params.branchCode), itemCode = clean(params.itemCode), category = clean(params.category);
  if (branchCode) branches = branches.filter(function(b){return b.code === branchCode;});
  if (itemCode) items = items.filter(function(i){return i.code === itemCode;});
  if (category) items = items.filter(function(i){return i.category === category;});

  // لوحة الإدارة يجب أن تقرأ المدخلات من المصدر الذي يحفظه الجرد اليومي نفسه.
  // سابقًا كانت تعتمد على ورقة «الحركات» للمستلم والمرتجعات والضيافة والمباع؛
  // وهذه القيم تُحفظ في «الجرد اليومي»، لذلك كانت تختفي من التقارير.
  var inventory = getInventoryRecords();
  var dailyByKey = {}, actualBefore = {}, actualThrough = {};
  function keyFor(b, i) { return clean(b) + '|' + clean(i); }
  inventory.forEach(function(r, index) {
    var bc = clean(r['كود الفرع']), ic = clean(r['كود الصنف']);
    if (!bc || !ic || !r['التاريخ']) return;
    var d; try { d = dateKey(r['التاريخ']); } catch(e) { return; }
    var key = keyFor(bc, ic);
    if (d < fromKey && r['الجرد الفعلي'] !== '' && r['الجرد الفعلي'] != null) {
      if (!actualBefore[key] || d > actualBefore[key].date || (d === actualBefore[key].date && index > actualBefore[key].index)) {
        actualBefore[key] = {date:d, actual:toNumber(r['الجرد الفعلي']), index:index};
      }
    }
    if (d <= toKey && r['الجرد الفعلي'] !== '' && r['الجرد الفعلي'] != null) {
      if (!actualThrough[key] || d > actualThrough[key].date || (d === actualThrough[key].date && index > actualThrough[key].index)) {
        actualThrough[key] = {date:d, actual:toNumber(r['الجرد الفعلي']), index:index};
      }
    }
    // منع مضاعفة البيانات إذا وُجد أكثر من سجل للصنف نفسه في اليوم نفسه؛
    // نتبع سلوك الجرد اليومي ونستخدم آخر سجل مطابق.
    var dayKey = key + '|' + d;
    if (!dailyByKey[dayKey] || index > dailyByKey[dayKey]._index) {
      dailyByKey[dayKey] = {
        _index:index, date:d, openingRaw:r['رصيد أول المدة'],
        received:toNumber(r['المستلم']),
        returnsQty:toNumber(r['المرتجعات'] !== '' && r['المرتجعات'] != null ? r['المرتجعات'] : r['المرتجع']),
        hospitality:toNumber(r['الضيافة']), sold:toNumber(r['المباع']),
        actual:(r['الجرد الفعلي'] === '' || r['الجرد الفعلي'] == null) ? null : toNumber(r['الجرد الفعلي'])
      };
    }
  });

  var dailyTotalsByKey = {};
  Object.keys(dailyByKey).forEach(function(dayKey) {
    var rec = dailyByKey[dayKey];
    if (rec.date < fromKey || rec.date > toKey) return;
    var key = dayKey.substring(0, dayKey.lastIndexOf('|'));
    var t = dailyTotalsByKey[key] || (dailyTotalsByKey[key] = {received:0,returnsQty:0,hospitality:0,sold:0});
    t.received += rec.received; t.returnsQty += rec.returnsQty;
    t.hospitality += rec.hospitality; t.sold += rec.sold;
  });

  // التحويلات تُقرأ من دفتر الحركات؛ قبول التحويل يكتب الحركة هناك بتاريخ التحويل الأصلي.
  // لا نقرأ الأنواع الأخرى من دفتر الحركات حتى لا نضاعف مدخلات الجرد اليومي.
  var transferTotals = {}, postedTransferMovementKeys = {}, branchCodeByAlias = {};
  getBranchesForUI().forEach(function(b) { branchCodeByAlias[clean(b.code)] = clean(b.code); branchCodeByAlias[clean(b.name)] = clean(b.code); });
  function transferMovementKey(ref, branch, item, type) {
    return [clean(ref), clean(branch), clean(item), clean(type)].join('|');
  }
  getMovements().forEach(function(r) {
    var type = clean(r['نوع الحركة']);
    if (type !== 'تحويل وارد' && type !== 'تحويل منصرف') return;
    var rawBranch = clean(r['كود الفرع']), bc = branchCodeByAlias[rawBranch] || rawBranch, ic = clean(r['كود الصنف']);
    if (!bc || !ic || !r['التاريخ']) return;
    var ref = clean(r['المرجع']);
    var d; try { d = dateKey(r['التاريخ']); } catch(e) { return; }
    if (d < fromKey || d > toKey) return;
    if (ref) postedTransferMovementKeys[transferMovementKey(ref, bc, ic, type)] = true;
    var key = keyFor(bc, ic), t = transferTotals[key] || (transferTotals[key] = {transferIn:0,transferOut:0});
    if (type === 'تحويل وارد') t.transferIn += toNumber(r['الكمية']);
    else t.transferOut += toNumber(r['الكمية']);
  });
  // بعض التحويلات القديمة/المستوردة قد تكون مقبولة ومُرحّلة في ورقة «التحويلات»
  // لكن حركاتها المقابلة غير موجودة في «الحركات». نضيف المفقود فقط، ولا نكرر
  // أي تحويل له حركة مسجلة بالفعل.
  getTransfers().forEach(function(trow) {
    var status = clean(trow['الحالة']), posted = clean(trow['تم ترحيله']);
    if (status !== 'مقبول' || (posted && posted !== 'نعم' && posted !== 'TRUE' && posted !== 'true')) return;
    var transferCode = clean(trow['كود التحويل']), item = clean(trow['كود الصنف']);
    var fromBranchRaw = clean(trow['الفرع المحوّل']), toBranchRaw = clean(trow['الفرع المستلم']);
    var fromBranch = branchCodeByAlias[fromBranchRaw] || fromBranchRaw;
    var toBranch = branchCodeByAlias[toBranchRaw] || toBranchRaw;
    var d; try { d = dateKey(trow['التاريخ']); } catch(e) { return; }
    if (d < fromKey || d > toKey || !item || !transferCode) return;
    var qty = toNumber(trow['الكمية']); if (qty <= 0) return;
    if (!postedTransferMovementKeys[transferMovementKey(transferCode, fromBranch, item, 'تحويل منصرف')]) {
      var outKey = keyFor(fromBranch, item), outTotal = transferTotals[outKey] || (transferTotals[outKey] = {transferIn:0,transferOut:0});
      outTotal.transferOut += qty;
    }
    if (!postedTransferMovementKeys[transferMovementKey(transferCode, toBranch, item, 'تحويل وارد')]) {
      var inKey = keyFor(toBranch, item), inTotal = transferTotals[inKey] || (transferTotals[inKey] = {transferIn:0,transferOut:0});
      inTotal.transferIn += qty;
    }
  });

  var rows = [];
  branches.forEach(function(b) { items.forEach(function(i) {
    var key = keyFor(b.code, i.code);
    var totals = dailyTotalsByKey[key] || {received:0,returnsQty:0,hospitality:0,sold:0};
    var startRecord = dailyByKey[key + '|' + fromKey];
    var opening = (startRecord && startRecord.openingRaw !== '' && startRecord.openingRaw != null)
      ? toNumber(startRecord.openingRaw)
      : (actualBefore[key] ? actualBefore[key].actual : 0);

    var transfers = transferTotals[key] || {transferIn:0,transferOut:0};
    var expected = opening + totals.received - totals.returnsQty - totals.hospitality + transfers.transferIn - transfers.transferOut;
    var ending = expected - totals.sold;
    var latest = actualThrough[key], actual = latest ? latest.actual : null;
    rows.push({
      branchCode:b.code, branchName:b.name, itemCode:i.code, itemName:i.name,
      unit:i.unit, category:i.category, opening:opening, received:totals.received,
      returnsQty:totals.returnsQty, hospitality:totals.hospitality,
      transferIn:transfers.transferIn, transferOut:transfers.transferOut,
      sold:totals.sold, expected:expected, ending:ending, actual:actual,
      difference:actual === null ? null : actual - ending
    });
  }); });
  return {success:true,fromDate:fromKey,toDate:toKey,branchCode:branchCode,rows:rows};
}

/* =========================================================
   إصلاح دالة المراجعة اليومية (تجنب أخطاء التواريخ)
   ========================================================= */

function getDailyReview(params, token) {
  if (token) { try { requireSystemManagerSession(token); } catch(e) {} }
  params = params || {};
  var from = dateOnly(params.fromDate || params.date);
  var to = dateOnly(params.toDate || params.date);
  var fromKey = dateKey(from), toKey = dateKey(to);
  var branch = clean(params.branchCode);
  if (!branch) throw new Error('يجب اختيار الفرع.');
  if (toKey < fromKey) throw new Error('حدد فترة صحيحة؛ تاريخ النهاية يجب ألا يسبق البداية.');
  
  var days = [];
  var partsF = fromKey.split('-');
  var cursor = new Date(Number(partsF[0]), Number(partsF[1]) - 1, Number(partsF[2]));
  var partsT = toKey.split('-');
  var end = new Date(Number(partsT[0]), Number(partsT[1]) - 1, Number(partsT[2]));

  while (cursor.getTime() <= end.getTime()) {
    days.push(Utilities.formatDate(cursor, Session.getScriptTimeZone(), 'yyyy-MM-dd'));
    cursor.setDate(cursor.getDate() + 1);
    if (days.length > 370) throw new Error('الفترة المطلوبة أطول من الحد المسموح (370 يومًا).');
  }

  var daily = {};
  days.forEach(function(day){
    daily[day] = { date: day, received: 0, returnsQty: 0, hospitality: 0, transferIn: 0, transferOut: 0 };
  });

  getSheetObjects('الجرد اليومي').forEach(function(r){
    if (clean(r['كود الفرع']) !== branch) return;
    var day; try { day = dateKey(r['التاريخ']); } catch (e) { return; } if (!daily[day]) return;
    daily[day].received += toNumber(r['المستلم']);
    daily[day].returnsQty += toNumber(r['المرتجعات'] || r['المرتجع']);
    daily[day].hospitality += toNumber(r['الضيافة']);
    daily[day].transferIn += toNumber(r['التحويل الوارد'] || r['تحويل وارد']);
    daily[day].transferOut += toNumber(r['التحويل المنصرف'] || r['تحويل منصرف']);
  });
  // بيانات التحويلات في تقارير المراجعة تُستخرج من دفتر الحركات، لأن أعمدة التحويل
  // في سجل الجرد قد تكون مشتقة في الواجهة ولا تُخزّن داخل ورقة «الجرد اليومي».
  var ledgerTransferTotals = {}, ledgerTransferSeen = {};
  getMovements().forEach(function(m){
    var type=clean(m['نوع الحركة']); if(type!=='تحويل وارد'&&type!=='تحويل منصرف') return;
    if(clean(m['كود الفرع'])!==branch) return;
    var day; try{day=dateKey(m['التاريخ']);}catch(e){return;} if(!daily[day]) return;
    var key=day+'|'+type, entry=ledgerTransferTotals[key]||(ledgerTransferTotals[key]={quantity:0,refs:{}});
    entry.quantity+=toNumber(m['الكمية']);
    if(clean(m['المرجع'])) entry.refs[clean(m['المرجع'])]=true;
    ledgerTransferSeen[key]=true;
  });
  var branchesForReview=getBranchesForUI(), aliasToCode={};
  branchesForReview.forEach(function(b){aliasToCode[clean(b.code)]=clean(b.code);aliasToCode[clean(b.name)]=clean(b.code);});
  var transferSheetFallback={};
  getTransfers().forEach(function(trow){
    if(clean(trow['الحالة'])!=='مقبول') return;
    var posted=clean(trow['تم ترحيله']); if(posted&&['نعم','TRUE','true'].indexOf(posted)<0)return;
    var day;try{day=dateKey(trow['التاريخ']);}catch(e){return;}if(!daily[day])return;
    var from=aliasToCode[clean(trow['الفرع المحوّل'])]||clean(trow['الفرع المحوّل']);
    var to=aliasToCode[clean(trow['الفرع المستلم'])]||clean(trow['الفرع المستلم']);
    var code=clean(trow['كود التحويل']),item=clean(trow['كود الصنف']),qty=toNumber(trow['الكمية']);
    if(!code||qty<=0)return;
    [{branch:from,type:'تحويل منصرف'},{branch:to,type:'تحويل وارد'}].forEach(function(x){
      if(x.branch!==branch)return;
      var key=day+'|'+x.type, ledger=ledgerTransferTotals[key];
      if(ledger&&ledger.refs[code])return;
      var fb=transferSheetFallback[key]||(transferSheetFallback[key]={quantity:0});fb.quantity+=qty;
    });
  });
  days.forEach(function(day){
    ['تحويل وارد','تحويل منصرف'].forEach(function(type){
      var key=day+'|'+type, ledger=ledgerTransferTotals[key], fallback=transferSheetFallback[key];
      if(ledger) { if(type==='تحويل وارد') daily[day].transferIn=ledger.quantity; else daily[day].transferOut=ledger.quantity; }
      else if(fallback) { if(type==='تحويل وارد') daily[day].transferIn=fallback.quantity; else daily[day].transferOut=fallback.quantity; }
    });
  });

  var rows = days.map(function(day){ return daily[day]; });
  return { success: true, fromDate: fromKey, toDate: toKey, branchCode: branch, branchName: getBranchName(branch), rows: rows };
}

/* =========================================================
   الإدارة والأصناف والمستخدمون التكميلية
   ========================================================= */

function addItem(data, token) {
  requireSystemManagerSession(token);
  data = data || {};
  var name = clean(data.name), unit = clean(data.unit), category = clean(data.category);
  if (!name) throw new Error('اسم الصنف مطلوب.');
  if (!unit) throw new Error('وحدة الصنف مطلوبة.');
  if (!category) throw new Error('اختر تصنيفًا للصنف قبل حفظه.');

  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var sheet = getSheet('الأصناف');
    var lastCol = sheet.getLastColumn();
    if (lastCol < 1) throw new Error('ورقة «الأصناف» لا تحتوي على عناوين أعمدة.');
    var codeCol = zenobiaFindColumn_(sheet, ['كود الصنف','كود المنتج','رمز الصنف','كود'], 1);
    var nameCol = zenobiaFindColumn_(sheet, ['اسم الصنف','اسم المنتج','الصنف','المنتج'], 2);
    var unitCol = zenobiaFindColumn_(sheet, ['الوحدة','وحدة القياس','وحدة الصنف'], 3);
    var categoryCol = zenobiaFindColumn_(sheet, ['التصنيف','الفئة','تصنيف الصنف'], 4);
    var orderCol = zenobiaFindColumn_(sheet, ['ترتيب العرض','الترتيب','ترتيب الصنف'], 5);
    var statusCol = zenobiaFindColumn_(sheet, ['الحالة','حالة الصنف','حالة التنشيط'], 6);
    var createdCol = zenobiaFindColumn_(sheet, ['تاريخ الإنشاء'], 7);
    if ([codeCol,nameCol,unitCol,categoryCol].some(function(c){return !c;})) {
      throw new Error('تعذر تحديد أعمدة الكود والاسم والوحدة والتصنيف في ورقة «الأصناف». راجع عناوين الصف الأول.');
    }

    var lastRow = sheet.getLastRow();
    var rows = lastRow >= 2 ? sheet.getRange(2,1,lastRow-1,lastCol).getDisplayValues() : [];
    var maxCode = 0, maxOrder = 0;
    rows.forEach(function(r){
      var existingName = clean(r[nameCol-1]), existingUnit = clean(r[unitCol-1]);
      if (existingName.toLocaleLowerCase() === name.toLocaleLowerCase() && existingUnit.toLocaleLowerCase() === unit.toLocaleLowerCase()) {
        throw new Error('يوجد صنف بالاسم والوحدة نفسيهما بالفعل: «' + name + '». استخدم تعديل الصنف الموجود بدلًا من تكراره.');
      }
      var m = clean(r[codeCol-1]).match(/^ITM-(\d+)$/i);
      if (m) maxCode = Math.max(maxCode, Number(m[1]));
      if (orderCol) maxOrder = Math.max(maxOrder, Number(r[orderCol-1]) || 0);
    });
    // استند أيضًا إلى أعلى كود محفوظ في السجلات التاريخية وإلى العداد الدائم؛ لا نعيد استخدام كود صنف حُذف من الكتالوج.
    var historyIndexForCode = zenobiaGetItemHistoryIndex_();
    Object.keys(historyIndexForCode).forEach(function(existingCode){
      var m=clean(existingCode).match(/^ITM-(\d+)$/i);
      if(m)maxCode=Math.max(maxCode,Number(m[1]));
    });
    var sequenceProperties=PropertiesService.getScriptProperties();
    var savedSequence=Number(sequenceProperties.getProperty('ZENOBIA_ITEM_CODE_SEQUENCE')||0);
    maxCode=Math.max(maxCode,savedSequence);

    // تأكد من وجود التصنيف قبل إنشاء سجل الصنف حتى لا يُحفظ نصف الطلب فقط.
    ensureCategoryExists_(category);
    var nextCodeNumber=maxCode+1;
    sequenceProperties.setProperty('ZENOBIA_ITEM_CODE_SEQUENCE',String(nextCodeNumber));
    var code = 'ITM-' + String(nextCodeNumber).padStart(4,'0');
    var requestedOrder = Number(data.displayOrder);
    var displayOrder = Number.isInteger(requestedOrder) && requestedOrder > 0 ? requestedOrder : maxOrder + 1;
    var newRow = new Array(lastCol).fill('');
    newRow[codeCol-1] = code;
    newRow[nameCol-1] = name;
    newRow[unitCol-1] = unit;
    newRow[categoryCol-1] = category;
    if (orderCol) newRow[orderCol-1] = displayOrder;
    if (statusCol) newRow[statusCol-1] = 'نشط';
    if (createdCol) newRow[createdCol-1] = now();

    var targetRow = sheet.getLastRow() + 1;
    sheet.getRange(targetRow,1,1,lastCol).setValues([newRow]);
    SpreadsheetApp.flush();
    var saved = sheet.getRange(targetRow,1,1,lastCol).getDisplayValues()[0];
    if (clean(saved[codeCol-1]) !== code || clean(saved[nameCol-1]) !== name || clean(saved[unitCol-1]) !== unit || clean(saved[categoryCol-1]) !== category) {
      throw new Error('أُرسل طلب إضافة الصنف لكن تعذّر تأكيد القيم بعد قراءتها من ورقة «الأصناف». لم أعرض رسالة نجاح.');
    }
    invalidateInitialDataCache();
    return {success:true, code:code, name:name, unit:unit, category:category, row:targetRow, displayOrder:displayOrder};
  } finally { lock.releaseLock(); }
}

function setItemStatus(data, token) {
  requireSystemManagerSession(token);
  data = data || {};
  var code = clean(data.code || data.itemCode || data['كود الصنف']);
  var requestedStatus = clean(data.status || data['الحالة']);
  if (!code) throw new Error('كود الصنف مطلوب لتغيير حالة التنشيط.');
  var status = (requestedStatus === 'نشط' || requestedStatus === 'فعال' || requestedStatus === 'مفعل' || requestedStatus === 'مفعّل')
    ? 'نشط'
