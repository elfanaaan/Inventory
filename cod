function getExcelMatchSystemTotals(params, token) {
  requireSystemManagerSession(token);
  params = params || {};
  var requestedPairs = Array.isArray(params.keys) ? params.keys : [];
  if (!requestedPairs.length) throw new Error('لم يتم إرسال أي أيام أو فروع للمطابقة.');
  if (requestedPairs.length > 3000) throw new Error('عدد أيام الفروع المطلوب فحصها أكبر من الحد المسموح. قسّم المطابقة إلى فترة أقصر.');

  var allBranches = getExcelMatchBranchOptions(token);
  var branchByCode = {}, branchAliasToCode = {};
  allBranches.forEach(function(b) {
    var code = clean(b.code), name = clean(b.name);
    branchByCode[code] = {name:name, status:clean(b.status)};
    branchAliasToCode[code] = code;
    branchAliasToCode[name] = code;
  });

  var resultByKey = {};
  var resultKeys = [];
  requestedPairs.forEach(function(pair) {
    pair = pair || {};
    var branchCode = clean(pair.branchCode);
    var date = clean(pair.date);
    if (!branchByCode[branchCode]) throw new Error('الفرع المحدد للمطابقة غير موجود في سجل الفروع: ' + branchCode);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) throw new Error('تاريخ غير صالح في طلب المطابقة: ' + date);
    var parsedDate = new Date(date + 'T12:00:00');
    if (isNaN(parsedDate.getTime()) || Utilities.formatDate(parsedDate, Session.getScriptTimeZone(), 'yyyy-MM-dd') !== date) {
      throw new Error('تعذر التحقق من صحة التاريخ: ' + date);
    }
    var key = date + '|' + branchCode;
    if (resultByKey[key]) return;
    resultByKey[key] = {
      date: date,
      branchCode: branchCode,
      branchName: branchByCode[branchCode].name,
      received: 0,
      returnsQty: 0,
      transferIn: 0,
      transferOut: 0,
      hospitality: 0,
      hasRecords: false
    };
    resultKeys.push(key);
  });

  // محاكاة الإجمالي العام الظاهر في جدول الجرد: الأصناف النشطة فقط، مع استثناء تصنيف الشمع.
  // لا تُقرأ مبيعات أو أسعار أو قيم مالية، ولا تُكتب أي بيانات في أي ورقة.
  var visibleItems = {}, eligibleItems = {};
  getItemsForUI().forEach(function(item) {
    var code = clean(item.code), category = clean(item.category).replace(/[\sـ]/g, '');
    if (!code) return;
    visibleItems[code] = true;
    if (category !== 'الشمع') eligibleItems[code] = true;
  });
  getInventoryRecords().forEach(function(record) {
    var branchCode = clean(record['كود الفرع']);
    var date;
    if (!branchCode || !record['التاريخ']) return;
    try { date = dateKey(record['التاريخ']); } catch (e) { return; }
    var row = resultByKey[date + '|' + branchCode];
    if (!row) return;
    var itemCode = clean(record['كود الصنف']);
    if (!itemCode || !visibleItems[itemCode]) return;
    row.hasRecords = true;
    if (!eligibleItems[itemCode]) return;
    row.received += toNumber(record['المستلم']);
    row.returnsQty += toNumber(record['المرتجعات']);
    row.hospitality += toNumber(record['الضيافة']);
  });

  // التحويلات اليومية في الواجهة تُحسب من ورقة «التحويلات»، لا من قيمها الخام في سجل الجرد.
  // يُستبعد الملغي، ولا تُخصم/تضاف التحويلات المعلقة؛ وهذا يطابق إجمالي العرض اليومي.
  getTransfers().forEach(function(t) {
    var status = clean(t['الحالة']);
    if (['ملغى بالمحو','ملغي','ملغى','ملغاة'].indexOf(status) >= 0) return;
    if (status === 'قيد الانتظار' || status === 'معلق') return;
    if (!clean(t['كود الصنف'])) return;
    var date = transferDateKey_(t['التاريخ']);
    if (!date) return;
    var fromCode = branchAliasToCode[clean(t['الفرع المحوّل'])] || '';
    var toCode = branchAliasToCode[clean(t['الفرع المستلم'])] || '';
    var quantity = toNumber(t['الكمية']);
    if (!quantity) return;
    var outRow = resultByKey[date + '|' + fromCode];
    if (outRow) outRow.transferOut += quantity;
    var inRow = resultByKey[date + '|' + toCode];
    if (inRow) inRow.transferIn += quantity;
  });

  return {
    success: true,
    totals: resultKeys.map(function(key) { return resultByKey[key]; }),
    checkedAt: Utilities.formatDate(now(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss')
  };
}

function zenobiaHeaderIndex_(headers, aliases, fallback) {
  function norm(value) {
    return clean(value).replace(/[\sـ]+/g, '').replace(/[ًٌٍَُِّْ]/g, '');
  }
  var normalized = headers.map(norm);
  for (var a = 0; a < aliases.length; a++) {
    var wanted = norm(aliases[a]);
    var index = normalized.indexOf(wanted);
    if (index >= 0) return index;
  }
  return fallback >= 0 && fallback < headers.length ? fallback : -1;
}

