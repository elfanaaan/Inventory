// حساب الأرصدة بقراءة ورقتي الجرد والحركات مرة واحدة بدل إعادة قراءتهما
// لكل صنف؛ وهذا مهم خصوصًا في التحويلات ولوحة الإدارة التي تستعلم عن عدة فروع.
function getBalancesForBranches_(branchCodes) {
  var codes = (branchCodes || []).map(clean).filter(Boolean);
  if (!codes.length) return {};
  var codeSet = {};
  codes.forEach(function(c) { codeSet[c] = true; });
  var items = getItemsForUI();
  var inventoryRows = getInventoryRecords();
  var movements = getMovementRows();
  var today = dateOnly(new Date()).getTime();
  var latestByKey = {};
  var keyFor = function(branch, item) { return clean(branch) + '\u0001' + clean(item); };

  inventoryRows.forEach(function(row) {
    var branch = clean(row['كود الفرع']);
    if (!codeSet[branch]) return;
    var item = clean(row['كود الصنف']);
    if (!item) return;
    var d;
    try { d = dateOnly(row['التاريخ']).getTime(); } catch (e) { return; }
    if (!isFinite(d) || d > today) return;
    var key = keyFor(branch, item), old = latestByKey[key];
    if (!old || d > old.date) {
      latestByKey[key] = {date:d, actual:toNumber(row['الجرد الفعلي'])};
    }
  });

  var movementTotals = {};
  movements.forEach(function(row) {
    var branch = clean(row['كود الفرع']);
    if (!codeSet[branch]) return;
    var item = clean(row['كود الصنف']);
    if (!item) return;
    var key = keyFor(branch, item), latest = latestByKey[key];
    var startDate = latest ? latest.date : new Date(2000, 0, 1).getTime();
    var d;
    try { d = dateOnly(row['التاريخ']).getTime(); } catch (e) { return; }
    if (!isFinite(d) || d < startDate || d > today) return;
    var total = movementTotals[key];
    if (!total) total = movementTotals[key] = {received:0,returnsQty:0,hospitality:0,transferIn:0,transferOut:0,sold:0};
    var qty = toNumber(row['الكمية']), type = clean(row['نوع الحركة']);
    if (type === 'استلام' || type === 'وارد') total.received += qty;
    else if (type === 'مرتجع') total.returnsQty += qty;
    else if (type === 'ضيافة') total.hospitality += qty;
    else if (type === 'تحويل وارد') total.transferIn += qty;
    else if (type === 'تحويل منصرف') total.transferOut += qty;
    else if (type === 'بيع' || type === 'مباع') total.sold += qty;
  });

  var result = {};
  codes.forEach(function(branch) {
    result[branch] = items.map(function(item) {
      var key = keyFor(branch, item.code), latest = latestByKey[key];
      var totals = movementTotals[key] || {received:0,returnsQty:0,hospitality:0,transferIn:0,transferOut:0,sold:0};
      var opening = latest ? latest.actual : 0;
      var balance = opening + totals.received - totals.returnsQty - totals.hospitality + totals.transferIn - totals.transferOut - totals.sold;
      return {itemCode:item.code,itemName:item.name,unit:item.unit,opening:opening,received:totals.received,returnsQty:totals.returnsQty,hospitality:totals.hospitality,transferIn:totals.transferIn,transferOut:totals.transferOut,sold:totals.sold,balance:balance};
    });
  });
  return result;
}

// يحسب رصيد الصنف حتى تاريخ محدد، انطلاقًا من آخر جرد فعلي سابق/مساوٍ للتاريخ.
// لا يستخدم لقطة جرد أحدث من تاريخ التحويل، ولا يكرر حركات التحويل المسجلة في دفتر الحركات.

function getBranchItemAvailableAtDate_(branchCode, itemCode, targetKey, excludeTransferCode) {
  branchCode = clean(branchCode);
  itemCode = clean(itemCode);
  targetKey = clean(targetKey);
  excludeTransferCode = clean(excludeTransferCode);

  var inventory = getInventoryRecords();
  var latest = null;
  var earliest = null;
  var dailyByDate = {};

  // تحديد آخر جرد فعلي وأول سجل للصنف.
  inventory.forEach(function(r) {
    if (
      clean(r['كود الفرع']) !== branchCode ||
      clean(r['كود الصنف']) !== itemCode
    ) return;

    var d = transferDateKey_(r['التاريخ']);
    if (!d || d > targetKey) return;

    if (!earliest || d < earliest.date) {
      earliest = {
        date: d,
        opening: toNumber(r['رصيد أول المدة'])
      };
    }

    if (
      r['الجرد الفعلي'] !== '' &&
      r['الجرد الفعلي'] != null &&
      (!latest || d >= latest.date)
    ) {
      latest = {
        date: d,
        actual: toNumber(r['الجرد الفعلي'])
      };
    }

    // الاحتفاظ بسجل واحد لكل صنف في اليوم الواحد
    // منعاً لتكرار الكميات عند وجود صفوف قديمة مكررة.
    dailyByDate[d] = r;
  });

  var totals = {
    received: 0,
    returnsQty: 0,
    hospitality: 0,
    transferIn: 0,
    transferOut: 0,
    sold: 0
  };

  // حساب الحركات التشغيلية من الجرد اليومي.
  Object.keys(dailyByDate).forEach(function(d) {
    if (latest && d <= latest.date) return;

    var r = dailyByDate[d];

    totals.received += toNumber(r['المستلم']);
    totals.returnsQty += toNumber(r['المرتجعات']);
    totals.hospitality += toNumber(r['الضيافة']);
    totals.sold += toNumber(r['المباع']);
  });

  // احتساب رصيد أول المدة أو آخر جرد فعلي.
  var opening = latest
    ? latest.actual
    : (earliest ? earliest.opening : 0);

  // التحويلات فقط تُحسب من ورقة الحركات؛
  // الحركات التشغيلية أعلاه مصدرها الجرد اليومي.
  getMovements().forEach(function(m) {
    if (
      clean(m['كود الفرع']) !== branchCode ||
      clean(m['كود الصنف']) !== itemCode
    ) return;

    var d = transferDateKey_(m['التاريخ']);

    if (!d || d > targetKey) return;
    if (latest && d <= latest.date) return;
    if (!latest && earliest && d < earliest.date) return;

    var type = clean(m['نوع الحركة']);
    var quantity = toNumber(m['الكمية']);

    if (type === 'تحويل وارد') {
      totals.transferIn += quantity;
    } else if (type === 'تحويل منصرف') {
      totals.transferOut += quantity;
    }
  });

  var gross =
    opening +
    totals.received +
    totals.returnsQty -
    totals.hospitality +
    totals.transferIn -
    totals.transferOut -
    totals.sold;

  // التحويلات المعلقة تحجز من رصيد الفرع المحوّل فقط.
  var reserved = 0;

  getTransfers().forEach(function(t) {
    var d = transferDateKey_(t['التاريخ']);

    if (
      clean(t['كود التحويل']) === excludeTransferCode ||
      clean(t['الفرع المحوّل']) !== branchCode ||
      clean(t['كود الصنف']) !== itemCode ||
      !d ||
      d > targetKey ||
      (latest && d < latest.date)
    ) return;

    var status = clean(t['الحالة']);
    var type = clean(t['نوع التحويل']) || 'فرع → فرع';

    if (
      (status === 'قيد الانتظار' || status === 'معلق') &&
