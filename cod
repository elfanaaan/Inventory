function getSS() { return SpreadsheetApp.openById(SPREADSHEET_ID); }
function now() { return new Date(); }
function toNumber(v) { var n = Number(v); return isNaN(n) ? 0 : n; }
function clean(v) { return String(v == null ? '' : v).trim(); }
function dateOnly(v) { var d = v instanceof Date ? new Date(v) : new Date(v); d.setHours(0,0,0,0); return d; }
function dateKey(v) { return Utilities.formatDate(dateOnly(v), Session.getScriptTimeZone(), 'yyyy-MM-dd'); }

// مفتاح تاريخ التحويل يقبل قيمة خلية Date أو نص التاريخ المعروض في الشيت.
// أمثلة: Date، 2026-10-14T13:32:06.000Z، 4:32:06 م 2026/10/14.
function transferDateKey_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }
  var raw = clean(value);
  if (!raw) return '';
  var iso = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (iso) return iso[1] + '-' + ('0' + iso[2]).slice(-2) + '-' + ('0' + iso[3]).slice(-2);
  var ymd = raw.match(/(\d{4})[\/.-](\d{1,2})[\/.-](\d{1,2})/);
  if (ymd) return ymd[1] + '-' + ('0' + ymd[2]).slice(-2) + '-' + ('0' + ymd[3]).slice(-2);
  var dmy = raw.match(/(?:^|\s)(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})(?:$|\s)/);
  if (dmy) return dmy[3] + '-' + ('0' + dmy[2]).slice(-2) + '-' + ('0' + dmy[1]).slice(-2);
  var parsed = new Date(raw);
  if (!isNaN(parsed.getTime())) return Utilities.formatDate(parsed, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  return '';
}


function getSheet(name) {
  var sheet = getSS().getSheetByName(name);
  if (!sheet) throw new Error('ورقة "' + name + '" غير موجودة.');
  return sheet;
}

function ensureHeaders(sheet, headers) {
  if (sheet.getLastColumn() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]).setFontWeight('bold');
    sheet.setFrozenRows(1);
    return;
  }
  var current = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(clean);
  headers.forEach(function(h) {
    if (current.indexOf(h) === -1) {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(h);
    }
  });
}

function getHeaderMap(sheet) {
  var map = {};
  if (sheet.getLastColumn() > 0) {
    sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].forEach(function(h, i) {
      if (clean(h)) map[clean(h)] = i + 1;
    });
  }
  return map;
}

// بحث مرن في عناوين الأعمدة: يتجاهل المسافات والتطويل والتشكيل واختلافات بسيطة في كتابة العنوان.
function zenobiaNormalizeHeader_(value) {
  return clean(value).replace(/[\sـ]+/g, '').replace(/[ًٌٍَُِّْٰ]/g, '').toLowerCase();
}
function zenobiaFindColumn_(sheet, aliases, fallback) {
  var lastCol = sheet.getLastColumn();
  if (lastCol < 1) return fallback || 0;
  var headers = sheet.getRange(1, 1, 1, lastCol).getDisplayValues()[0];
  var normalized = headers.map(zenobiaNormalizeHeader_);
  for (var i = 0; i < aliases.length; i++) {
    var wanted = zenobiaNormalizeHeader_(aliases[i]);
    var at = normalized.indexOf(wanted);
    if (at >= 0) return at + 1;
  }
  return fallback && fallback <= lastCol ? fallback : 0;
}
function zenobiaFindRowByValue_(sheet, col, value) {
  if (!col || sheet.getLastRow() < 2) return 0;
  var wanted = clean(value);
  var vals = sheet.getRange(2, col, sheet.getLastRow() - 1, 1).getDisplayValues();
  for (var i = 0; i < vals.length; i++) {
    if (clean(vals[i][0]) === wanted) return i + 2;
  }
  return 0;
}
function zenobiaFindRowsByValue_(sheet, col, value) {
  if (!col || sheet.getLastRow() < 2) return [];
  var wanted = clean(value);
  var vals = sheet.getRange(2, col, sheet.getLastRow() - 1, 1).getDisplayValues();
  var rows = [];
  for (var i = 0; i < vals.length; i++) if (clean(vals[i][0]) === wanted) rows.push(i + 2);
  return rows;
}
function zenobiaWriteAndVerify_(sheet, row, col, value, label) {
  if (!row || !col) throw new Error('تعذر تحديد صف أو عمود ' + label + ' في ورقة ' + sheet.getName() + '.');
  sheet.getRange(row, col).setValue(value);
  SpreadsheetApp.flush();
  var actual = clean(sheet.getRange(row, col).getDisplayValue());
  if (actual !== clean(value)) throw new Error('لم يتم تأكيد حفظ ' + label + '. القيمة المكتوبة لا تطابق القيمة المقروءة.');
}

function getSheetObjects(name) {
  var sheet = getSheet(name);
  if (sheet.getLastRow() < 2) return [];
  var vals = sheet.getRange(1, 1, sheet.getLastRow(), sheet.getLastColumn()).getValues();
  var headers = vals[0].map(clean);
  return vals.slice(1).map(function(row) {
    var obj = {};
    headers.forEach(function(h, i) { obj[h] = row[i]; });
    return obj;
  });
}

