function movementDateInRange(
  value,
  fromDate,
  toDate
) {

  const d =
    dateOnly(value)
      .getTime();

  const from =
    dateOnly(fromDate)
      .getTime();

  const to =
    dateOnly(toDate)
      .getTime();

  return (
    d >= from &&
    d <= to
  );
}

function calculateItemMovements(
  branchCode,
  itemCode,
  fromDate,
  toDate
) {

  const movements =
    getMovementRows();

  const result = {

    received:
      0,

    returnsQty:
      0,

    hospitality:
      0,

    transferIn:
      0,

    transferOut:
      0,

    sold:
      0,

    hospitalityTo:
      ''

  };

  movements.forEach(function(row) {

    if (

      clean(row['كود الفرع']) !==
        clean(branchCode) ||

      clean(row['كود الصنف']) !==
        clean(itemCode)

    ) {
      return;
    }

    if (
      !movementDateInRange(
        row['التاريخ'],
        fromDate,
        toDate
      )
    ) {
      return;
    }

    const qty =
      toNumber(row['الكمية']);

    const type =
      clean(row['نوع الحركة']);

    if (
      type === 'استلام' ||
      type === 'وارد'
    ) {

      result.received += qty;

    } else if (
      type === 'مرتجع'
    ) {

      result.returnsQty += qty;

    } else if (
      type === 'ضيافة'
    ) {

      result.hospitality += qty;

      if (
        clean(row['الجهة'])
      ) {

        result.hospitalityTo =
          clean(row['الجهة']);
      }

    } else if (
      type === 'تحويل وارد'
    ) {

      result.transferIn += qty;

    } else if (
      type === 'تحويل منصرف'
    ) {

      result.transferOut += qty;

    } else if (
      type === 'بيع' ||
      type === 'مباع'
    ) {

      result.sold += qty;
    }
  });

  return result;
}

