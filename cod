function loadCentralItems() {
  var sheet = getSheet('الأصناف');
  var lastRow = sheet.getLastRow();
  var existing = {};
  if (lastRow >= 2) {
    sheet.getRange(2, 1, lastRow - 1, 7).getValues().forEach(function(r) {
      if (clean(r[1])) existing[clean(r[1]) + '|' + clean(r[2])] = true;
    });
  }
  var rows = [];
  SOURCE_CENTRAL_ITEMS.forEach(function(it, idx) {
    var name = clean(it[0]), unit = clean(it[1]), cat = clean(it[2]);
    if (name && unit && !existing[name + '|' + unit]) {
      rows.push(['ITM-' + String(idx + 1).padStart(4, '0'), name, unit, cat, idx + 1, 'نشط', now()]);
    }
  });
  if (rows.length) sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, 7).setValues(rows);
  invalidateInitialDataCache();
}

function getItems() {
  // قراءة مباشرة من الشيت: لا نسمح للكاش بإخفاء صنف أو بإرجاع رقم صف قديم.
  var sheet = getSheet('الأصناف');
  var lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  var lastCol = sheet.getLastColumn();
  var headers = sheet.getRange(1,1,1,lastCol).getDisplayValues()[0];
  var rows = sheet.getRange(2,1,lastRow-1,lastCol).getDisplayValues();
  var ci=zenobiaHeaderIndex_(headers,['كود الصنف','كود المنتج','رمز الصنف','كود'],0);
  var ni=zenobiaHeaderIndex_(headers,['اسم الصنف','اسم المنتج','الصنف','المنتج'],1);
  var ui=zenobiaHeaderIndex_(headers,['الوحدة','وحدة القياس','وحدة الصنف'],2);
  var cat=zenobiaHeaderIndex_(headers,['التصنيف','الفئة','تصنيف الصنف'],3);
  var oi=zenobiaHeaderIndex_(headers,['ترتيب العرض','الترتيب','ترتيب الصنف'],4);
  var si=zenobiaHeaderIndex_(headers,['الحالة','حالة الصنف','حالة التنشيط'],5);
  return rows.map(function(r,i){
    return {code:ci>=0?clean(r[ci]):'',name:ni>=0?clean(r[ni]):'',unit:ui>=0?clean(r[ui]):'',
      category:cat>=0?clean(r[cat]):'',displayOrder:oi>=0?toNumber(r[oi]):0,
      status:si>=0?(clean(r[si])||'نشط'):'نشط',rowNumber:i+2};
  }).filter(function(item){return item.name||item.code;});
}
function zenobiaIsActiveItem_(status) {
  var v=clean(status).replace(/[\sـ]+/g,'').toLowerCase();
  return !v || ['نشط','فعال','مفعل','مفعّل','active','true','yes','نعم','1'].indexOf(v)>=0;
}
function getItemsForUI() {
  return getItems().filter(function(item){return zenobiaIsActiveItem_(item.status);});
}

