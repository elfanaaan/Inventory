  userName = clean(session.userName) || clean(userName);
  reason=clean(reason);
  if (decision !== 'قبول') throw new Error('التحويلات لا تُرفض من داخل النظام. اترك التحويل معلّقًا وتواصل مع الفرع المحوِّل لتعديل بياناته.');
  if(!reason) throw new Error('سبب اعتماد التحويل إلزامي.');
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var sheet = getSheet('التحويلات'), data = sheet.getDataRange().getValues(), map = getHeaderMap(sheet);
    var rowNumber = -1, row = null;
    for (var i=1;i<data.length;i++) if (clean(data[i][map['كود التحويل']-1])===clean(transferCode)) { rowNumber=i+1; row=data[i]; break; }
    if (!row) throw new Error('التحويل غير موجود.');
    var status=clean(row[map['الحالة']-1]);
    var transferType=clean(row[map['نوع التحويل']-1]) || 'فرع → فرع';
    if (transferType !== 'فرع → فرع') throw new Error('هذا النوع من التحويل لا يحتاج إلى موافقة الفرع المستلم.');
    var fromBranch=clean(row[map['الفرع المحوّل']-1]), toBranch=clean(row[map['الفرع المستلم']-1]);
    if (['مدير النظام','مدير','admin','ADMIN'].indexOf(role)<0 && clean(session.branchCode || session.selectedBranchCode)!==toBranch) throw new Error('لا يمكنك قبول تحويل غير موجّه إلى فرعك.');
    var itemCode=clean(row[map['كود الصنف']-1]), quantity=toNumber(row[map['الكمية']-1]);
    var movements=getMovements();
    var outPosted=movements.some(function(m){return clean(m['المرجع'])===clean(transferCode)&&clean(m['كود الفرع'])===fromBranch&&clean(m['نوع الحركة'])==='تحويل منصرف';});
    var inPosted=movements.some(function(m){return clean(m['المرجع'])===clean(transferCode)&&clean(m['كود الفرع'])===toBranch&&clean(m['نوع الحركة'])==='تحويل وارد';});
    if (status==='مقبول' && outPosted && inPosted && clean(row[map['تم ترحيله']-1])==='نعم') return {success:true,status:'مقبول',alreadyPosted:true,quantity:quantity};
    if (status!=='قيد الانتظار' && status!=='معلق' && status!=='' && !(status==='مقبول' && (!outPosted || !inPosted))) throw new Error('لا يمكن قبول التحويل لأنه في حالة: '+status);
    if (quantity<=0) throw new Error('كمية التحويل غير صحيحة.');
    // استخدم رصيد الصنف بتاريخ التحويل نفسه، لا أحدث رصيد حالي؛ فالأرصدة اللاحقة قد تجعل التحويل التاريخي يبدو غير صالح.
    var originalDate=row[map['التاريخ']-1], dateKeyValue=transferDateKey_(originalDate);
    if(!dateKeyValue) throw new Error('تاريخ التحويل الأصلي غير صالح؛ لم يتم الترحيل.');
    var availableAtDate=getBranchItemAvailableAtDate_(fromBranch,itemCode,dateKeyValue,transferCode);
    if (!outPosted && !inPosted && availableAtDate.available < quantity) {
      throw new Error('لا يمكن قبول التحويل: الكمية المتاحة بتاريخ '+dateKeyValue+' هي '+availableAtDate.available+' فقط بعد حجز التحويلات المعلّقة الأخرى. راجع الجرد الفعلي والحركات السابقة لهذا التاريخ.');
    }
    var parts=dateKeyValue.split('-'), movementDate=new Date(Number(parts[0]),Number(parts[1])-1,Number(parts[2]),12,0,0,0);
    if(!outPosted) saveMovement({date:movementDate,branchCode:fromBranch,itemCode:itemCode,type:'تحويل منصرف',quantity:quantity,reference:transferCode,party:toBranch,notes:'ترحيل تحويل معتمد',createdBy:userName});
    if(!inPosted) saveMovement({date:movementDate,branchCode:toBranch,itemCode:itemCode,type:'تحويل وارد',quantity:quantity,reference:transferCode,party:fromBranch,notes:'ترحيل تحويل معتمد',createdBy:userName});
    sheet.getRange(rowNumber,map['الحالة']).setValue('مقبول');
    sheet.getRange(rowNumber,map['صاحب القرار']).setValue(userName);
    sheet.getRange(rowNumber,map['وقت القرار']).setValue(now());
    sheet.getRange(rowNumber,map['سبب الرفض']).setValue('');
    sheet.getRange(rowNumber,map['وقت الترحيل']).setValue(now());
    sheet.getRange(rowNumber,map['تم ترحيله']).setValue('نعم');
    writeAuditEntry_(session,toBranch,'قبول تحويل','التحويلات',transferCode,'قيد الانتظار','مقبول','الصنف: '+itemCode+' | الكمية: '+quantity+' | الفرع المحوِّل: '+fromBranch+' | التاريخ الأصلي: '+dateKeyValue+' | سبب الاعتماد: '+reason);
    return {success:true,status:'مقبول',quantity:quantity,date:dateKeyValue};
  } finally { lock.releaseLock(); }
}

