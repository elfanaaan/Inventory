}function diagnoseSuez2TransferBalance() {
  var branch = 'B014';
  var item = 'ITM-0008';
  var target = '2026-10-01';
  var destination = 'B013';

  var inventory = getInventoryRecords();
  var movements = getMovements();
  var transfers = getTransfers();

  function key(value) {
    try {
      return transferDateKey_(value);
    } catch (e) {
      return '';
    }
  }

  var inventoryRows = inventory.filter(function(r) {
    return clean(r['كود الفرع']) === branch &&
      clean(r['كود الصنف']) === item &&
      key(r['التاريخ']) <= target;
  }).map(function(r) {
    return {
      date: key(r['التاريخ']),
      opening: r['رصيد أول المدة'],
      received: r['المستلم'],
      actual: r['الجرد الفعلي'],
      sold: r['المباع'],
      returns: r['المرتجعات'],
      hospitality: r['الضيافة']
    };
  });

  var movementRows = movements.filter(function(m) {
    return clean(m['كود الفرع']) === branch &&
      clean(m['كود الصنف']) === item &&
      key(m['التاريخ']) <= target;
  }).map(function(m) {
    return {
      date: key(m['التاريخ']),
      type: clean(m['نوع الحركة']),
      quantity: toNumber(m['الكمية']),
      reference: clean(m['المرجع']),
      party: clean(m['الطرف'])
    };
  });

  var pendingRows = transfers.filter(function(t) {
    return clean(t['الفرع المحوّل']) === branch &&
      clean(t['كود الصنف']) === item &&
      key(t['التاريخ']) <= target &&
      ['قيد الانتظار', 'معلق'].indexOf(clean(t['الحالة'])) >= 0;
  }).map(function(t) {
    return {
      code: clean(t['كود التحويل']),
      date: key(t['التاريخ']),
      destination: clean(t['الفرع المستلم']),
      quantity: toNumber(t['الكمية']),
      status: clean(t['الحالة'])
    };
  });

  var currentTransfer = pendingRows.find(function(t) {
    return t.destination === destination &&
      t.date === target &&
      t.quantity === 0.5;
  });

  var balance = getBranchItemAvailableAtDate_(
    branch,
    item,
    target,
    currentTransfer ? currentTransfer.code : ''
  );

  var result = {
    branch: branch,
    item: item,
    date: target,
    inventoryRecords: inventoryRows,
    movements: movementRows,
    pendingTransfers: pendingRows,
    currentTransferCode: currentTransfer ? currentTransfer.code : 'NOT FOUND',
    calculatedBalance: balance
  };

  Logger.log(JSON.stringify(result, null, 2));
  return result;
}
