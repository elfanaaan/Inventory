function getAdminMovementReport(params, token) {
  requireSystemManagerSession(token);
  params = params || {};
  var fromKey = params.fromDate ? dateKey(params.fromDate) : '';
  var toKey = params.toDate ? dateKey(params.toDate) : '';
  var branch = clean(params.branchCode), type = clean(params.type), item = clean(params.itemCode);
  var branches = {}, items = {};
  var branchAliasToCode = {};
  getBranchesForUI().forEach(function(b){branches[b.code]=b.name;branchAliasToCode[clean(b.code)]=clean(b.code);branchAliasToCode[clean(b.name)]=clean(b.code);});
  getItems().forEach(function(i){items[i.code]=i.name;});

  // تقارير الضيافة والمبيعات يجب أن تقرأ القيم المحفوظة في «الجرد اليومي»؛
  // فهي ليست بالضرورة مسجلة كحركات منفصلة في ورقة «الحركات».
  var rows = [], dailyKeys = {};
  if (type === 'ضيافة' || type === 'بيع' || type === 'مبيعات' || type === 'مباع') {
    getInventoryRecords().forEach(function(r, index) {
      var d, bc = clean(r['كود الفرع']), ic = clean(r['كود الصنف']);
      if (!bc || !ic || !r['التاريخ']) return;
      try { d = dateKey(r['التاريخ']); } catch(e) { return; }
      if ((fromKey && d < fromKey) || (toKey && d > toKey) || (branch && bc !== branch) || (item && ic !== item)) return;
      var isHospitality = type === 'ضيافة';
      var qty = isHospitality ? toNumber(r['الضيافة']) : toNumber(r['المباع']);
      if (qty <= 0) return;
      var dedupeKey = d + '|' + bc + '|' + ic + '|' + (isHospitality ? 'ضيافة' : 'بيع');
      dailyKeys[dedupeKey] = true;
      rows.push({
        code:clean(r['معرف السجل']) || ('DAILY-' + d + '-' + bc + '-' + ic),
        date:d, branchCode:bc, branchName:branches[bc]||bc,
        itemCode:ic, itemName:items[ic]||ic,
        type:isHospitality ? 'ضيافة' : 'بيع', quantity:qty,
        hospitalityBy:clean(r['بأمر من'] || r['الضيافة بأمر من']),
        hospitalityTo:clean(r['لمن'] || r['الضيافة إلى']),
        party:clean(r['لمن'] || r['الضيافة إلى']),
        reference:'الجرد اليومي', notes:clean(r['الملاحظات']),
        createdBy:clean(r['مرسل الجرد']), status:''
      });
    });
  }

  // نحافظ على سجلات الحركة القديمة التي لا يقابلها إدخال في الجرد اليومي،
  // لكن لا نكرر نفس العملية إذا كانت محفوظة في المصدرين.
  var seenTransferRefs = {};
  getMovements().forEach(function(r) {
    var d, rawBranch = clean(r['كود الفرع']), bc = branchAliasToCode[rawBranch] || rawBranch, ic = clean(r['كود الصنف']), movementType = clean(r['نوع الحركة']);
    try { d = dateKey(r['التاريخ']); } catch(e) { return; }
    var matchesType = !type || movementType === type || (type === 'بيع' && (movementType === 'مباع' || movementType === 'مبيعات'));
    if (!matchesType || (fromKey && d < fromKey) || (toKey && d > toKey) || (branch && bc !== branch) || (item && ic !== item)) return;
    var normalizedType = (movementType === 'مباع' || movementType === 'مبيعات') ? 'بيع' : movementType;
    var dedupeKey = d + '|' + bc + '|' + ic + '|' + normalizedType;
    if (dailyKeys[dedupeKey] && normalizedType !== 'تحويل وارد' && normalizedType !== 'تحويل منصرف') return;
    if (normalizedType === 'تحويل وارد' || normalizedType === 'تحويل منصرف') {
      var refKey = [clean(r['المرجع']), bc, ic, normalizedType].join('|');
      if (clean(r['المرجع'])) seenTransferRefs[refKey] = true;
    }
    rows.push({
      code:r['كود الحركة'], date:d, branchCode:bc, branchName:branches[bc]||bc,
      itemCode:ic, itemName:items[ic]||ic, type:normalizedType,
      quantity:toNumber(r['الكمية']), reference:r['المرجع']||'', party:r['الجهة']||'',
      hospitalityBy:clean(r['بأمر من']), hospitalityTo:clean(r['لمن']),
      notes:r['الملاحظات']||'', createdBy:r['منفذ الحركة']||r['مرسل الحركة']||'', status:r['الحالة']||''
    });
  });
  // إظهار التحويلات المقبولة/المُرحّلة حتى لو كانت حركة دفترها مفقودة، مع منع التكرار حسب مرجع التحويل.
  var branchNameByCode = {};
  getBranchesForUI().forEach(function(b){branchNameByCode[clean(b.code)]=clean(b.name);});
  if (type === 'تحويل وارد' || type === 'تحويل منصرف' || !type) {
    getTransfers().forEach(function(trow){
      if(clean(trow['الحالة'])!=='مقبول') return;
      var posted=clean(trow['تم ترحيله']); if(posted && ['نعم','TRUE','true'].indexOf(posted)<0) return;
      var d, transferCode=clean(trow['كود التحويل']), ic=clean(trow['كود الصنف']);
      try{d=dateKey(trow['التاريخ']);}catch(e){return;}
      if((fromKey&&d<fromKey)||(toKey&&d>toKey)|| (item&&ic!==item) || !transferCode || !ic) return;
      var fromRaw=clean(trow['الفرع المحوّل']),toRaw=clean(trow['الفرع المستلم']);
      var fromCode=branchAliasToCode[fromRaw]||fromRaw,toCode=branchAliasToCode[toRaw]||toRaw,qty=toNumber(trow['الكمية']);
      var candidates=[];
      if(type!=='تحويل وارد' && (!branch||branch===fromCode)) candidates.push({branch:fromCode,type:'تحويل منصرف',party:toCode});
      if(type!=='تحويل منصرف' && (!branch||branch===toCode)) candidates.push({branch:toCode,type:'تحويل وارد',party:fromCode});
      candidates.forEach(function(c){
        var refKey=[transferCode,c.branch,ic,c.type].join('|'); if(seenTransferRefs[refKey]) return;
        rows.push({code:transferCode+'-'+(c.type==='تحويل وارد'?'IN':'OUT'),date:d,branchCode:c.branch,branchName:branchNameByCode[c.branch]||c.branch,itemCode:ic,itemName:items[ic]||ic,type:c.type,quantity:qty,reference:transferCode,party:c.party,notes:clean(trow['سبب التحويل']),createdBy:clean(trow['طالب التحويل']),status:clean(trow['الحالة'])});
        seenTransferRefs[refKey]=true;
      });
    });
  }
  return rows.sort(function(a,b){return String(b.date).localeCompare(String(a.date));});
}

