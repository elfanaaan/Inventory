    }


    const code =
      branchCode(branch);

    const name =
      branchName(branch);


    return Boolean(
      String(code).trim() ||
      String(name).trim()
    );

  }


  function cleanBranches(branches) {

    if (!Array.isArray(branches)) {
      return [];
    }


    const result = [];

    const seen = {};


    branches.forEach(branch => {

      if (!isValidBranch(branch)) {
        return;
      }


      const code =
        String(
          branchCode(branch)
        ).trim();

      const name =
        String(
          branchName(branch)
        ).trim();


      const uniqueKey =
        code ||
        name;


      if (
        seen[uniqueKey]
      ) {
        return;
      }


      seen[uniqueKey] = true;


      result.push(branch);

    });


    return result;

  }


  function extractBranches(data) {

    if (!data) {
