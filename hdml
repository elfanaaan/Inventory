  async function loadAdminReferences() {
    const responses = await Promise.allSettled([
      server("getItems"), server("getBranches", state.token)
    ]);
    if (responses[0].status === "fulfilled") {
      const items = normalizeRows(responses[0].value).map(function(v,index){
        if (Array.isArray(v)) return {code:v[0],name:v[1],unit:v[2],category:v[3],displayOrder:v[4],status:v[5]||"نشط",createdAt:v[6],rowNumber:index+2,_sourceOrder:index+1};
        if (v && typeof v === "object") return {
          _sourceOrder:index+1,
          code:v.code ?? v.itemCode ?? v.item_id ?? v["كود الصنف"] ?? v["كود المنتج"] ?? "",
          name:v.name ?? v.itemName ?? v.item_name ?? v["اسم الصنف"] ?? v["اسم المنتج"] ?? v["الصنف"] ?? "",
          unit:v.unit ?? v["الوحدة"] ?? v["وحدة القياس"] ?? "",
          category:v.category ?? v["التصنيف"] ?? v["الفئة"] ?? "",
          displayOrder:v.displayOrder ?? v.order ?? v["ترتيب العرض"] ?? v["ترتيب الصنف"] ?? "",
          status:v.status ?? v["الحالة"] ?? "نشط",
          createdAt:v.createdAt ?? v["تاريخ الإنشاء"] ?? "",
          rowNumber:Number(v.rowNumber ?? v.row_number ?? v["رقم الصف"] ?? index+2)
        };
        return null;
      }).filter(function(v){ return v && (itemCode(v) || itemName(v)); });
      items.sort(function(a,b){const ao=Number(getRowValue(a,"displayOrder","ترتيب العرض","order")),bo=Number(getRowValue(b,"displayOrder","ترتيب العرض","order"));return (ao>0?ao:1000000+a._sourceOrder)-(bo>0?bo:1000000+b._sourceOrder);});
      state.items = items;
    } else console.error("فشل تحميل الأصناف من الخادم:", responses[0].reason);
    if (responses[1].status === "fulfilled") {
      const branches = normalizeRows(responses[1].value).map(function(b){
        return Array.isArray(b) ? {code:b[0],name:b[1],status:b[2]||"نشط",createdAt:b[3],entityType:b[4]||"فرع",displayOrder:b[5]} : b;
      }).filter(function(b){ return b && (branchCode(b) || branchName(b)); });
      if (branches.length) state.branches = branches;
    } else console.error("فشل تحميل الفروع من الخادم:", responses[1].reason);
    state.items = Array.isArray(state.items) ? state.items : [];
    state.branches = Array.isArray(state.branches) ? state.branches : DEFAULT_BRANCHES.slice();
    refreshAllAdminDropdowns();
    const body = document.getElementById("itemsBody");
    if (body && !state.items.length) body.innerHTML = '<tr><td colspan="8">تعذر تحميل الأصناف من الخادم. راجع سجل التنفيذ.</td></tr>';
    if (responses[0].status === "rejected" || responses[1].status === "rejected") {
      toast("تعذر تحميل بعض القوائم. راجع سجل التنفيذ؛ يمكنك التنقل بين الصفحات.","warning");
    }
  }

  function fillAnalysisSelectors() {
    // قوائم التحليل تعرض جميع الأصناف المسجلة؛ إخفاء الصنف من الجرد لا يمحو تاريخه.
    const allItemOptions = ['<option value="">كل الأصناف</option>'].concat((Array.isArray(state.items) ? state.items : []).map(item => `<option value="${escapeHtml(itemCode(item))}">${escapeHtml(itemName(item))}</option>`)).join("");
    [["dashItem",allItemOptions],["reportItem",allItemOptions]].forEach(([id,itemOptions]) => { const el=document.getElementById(id); if(!isRealSelect(el))return; const old=el.value; el.innerHTML=itemOptions; if(getSelectOptionsArray(el).some(o=>o.value===old))el.value=old; });
    const categories = getAvailableItemCategories();
    const categoryOptions = ['<option value="">كل التصنيفات</option>'].concat(categories.map(category=>`<option value="${escapeHtml(category)}">${escapeHtml(category)}</option>`)).join("");
    const cat=document.getElementById("reportCategory"); if(isRealSelect(cat)){const old=cat.value;cat.innerHTML=categoryOptions;if(getSelectOptionsArray(cat).some(o=>o.value===old))cat.value=old;}
    const itemsCatFilter=document.getElementById("itemsCategoryFilter");
    if(isRealSelect(itemsCatFilter)){
      const oldFilter=itemsCatFilter.value;
      itemsCatFilter.innerHTML='<option value="">كل التصنيفات</option>'+categories.map(category=>`<option value="${escapeHtml(category)}">${escapeHtml(category)}</option>`).join('');
      if(getSelectOptionsArray(itemsCatFilter).some(o=>o.value===oldFilter))itemsCatFilter.value=oldFilter;
    }
    const newCat=document.getElementById("newItemCategory");
    if(isRealSelect(newCat)){
      const old=newCat.value;
      newCat.innerHTML='<option value="">اختر التصنيف</option>'+categories.map(category=>`<option value="${escapeHtml(category)}">${escapeHtml(category)}</option>`).join('')+'<option value="__NEW_CATEGORY__">+ إضافة تصنيف جديد</option>';
