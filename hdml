  async function loadCategories() {
    const body = document.getElementById("categoriesBody");
    if (body) body.innerHTML = '<tr><td colspan="6">جارٍ تحميل التصنيفات...</td></tr>';
    try {
      const result = await server("getCategories", state.token);
      state.categories = normalizeRows(result).map(function(c,index){
        if (Array.isArray(c)) return {name:c[0],displayOrder:Number(c[1])||index+1,createdAt:c[2]||"",notes:c[3]||""};
        return {name:c.name ?? c.category ?? c["اسم التصنيف"] ?? "",displayOrder:Number(c.displayOrder ?? c.order ?? c["ترتيب العرض"])||index+1,createdAt:c.createdAt ?? c["تاريخ الإنشاء"] ?? "",notes:c.notes ?? c["ملاحظات"] ?? ""};
      }).filter(c => String(c.name||"").trim());
      const uniqueCategories = new Map();
      state.categories.forEach(function(c){ const key=String(c.name||"").trim(); if(!key) return; if(!uniqueCategories.has(key) || (Number(c.displayOrder)||999999) < (Number(uniqueCategories.get(key).displayOrder)||999999)) uniqueCategories.set(key,c); });
      state.categories = Array.from(uniqueCategories.values()).sort((a,b)=>(Number(a.displayOrder)||999999)-(Number(b.displayOrder)||999999));
      const seen = new Set(state.categories.map(c => String(c.name).trim()));
      // لا نضيف التصنيفات الافتراضية محليًا عند كل تحميل، حتى لا يظهر التصنيف المحذوف مجددًا.
      (state.items||[]).map(item => String(itemCategory(item)||"").trim()).filter(Boolean).forEach(function(name){
        if(name && !seen.has(name)){state.categories.push({name:name,displayOrder:state.categories.length+1,notes:""});seen.add(name);}
      });
      // لا ننشئ أو نعرض تصنيفًا بديلًا للأصناف التي لا تحمل تصنيفًا.
      renderCategoriesTable();
      renderCategorySplitTool();
      fillAnalysisSelectors();
      return state.categories;
    } catch (error) {
      if (body) body.innerHTML = '<tr><td colspan="6">تعذر تحميل التصنيفات: '+escapeHtml(error.message||error)+'</td></tr>';
      toast(error.message || "تعذر تحميل التصنيفات", "error");
      throw error;
    }
  }

