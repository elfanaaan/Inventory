function buildDailyGrandTotalExcludingWax(){
  const totals={opening:0,received:0,returnsQty:0,hospitality:0,transferIn:0,transferOut:0,expected:0,sold:0,ending:0,actual:0,difference:0};
  const tbody=document.getElementById('dailyTableBody');
  const domRows=tbody?Array.from(tbody.querySelectorAll('tr.daily-item-row[data-item-code]')):[];
  if(domRows.length){
    domRows.forEach(function(tr){
      if(String(tr.dataset.category||'').trim()==='الشمع')return;
      const code=String(tr.dataset.itemCode||'');
      const row=(state.dailyRows||[]).find(r=>String(getRowValue(r,'itemCode','كود الصنف')||'')===code)||{};
      const read=function(selector){const el=tr.querySelector(selector);return el?el.value:'';};
      const openingEl=tr.querySelector('.daily-opening');
      const opening=openingEl?num(openingEl.value):num(getRowValue(row,'opening','openingBalance','رصيد أول المدة'));
      const received=num(read('.daily-received'));
      const returnsQty=num(read('.daily-returns'));
      const hospitality=num(read('.daily-hospitality'));
      const sold=num(read('.daily-sold'));
      const actualRaw=read('.daily-actual');
      const actual=actualRaw===''?null:num(actualRaw);
      const info=dailyTransferInfo(code);
      const transferIn=info.incoming.reduce((a,t)=>a+num(t.qty)*(t.pending?0:1),0);
      const transferOut=info.outgoing.reduce((a,t)=>a+num(t.qty)*(t.pending?0:1),0);
      const expected=opening+received-returnsQty-hospitality+transferIn-transferOut;
      const ending=expected-sold;
      const difference=actual===null?null:actual-ending;
      totals.opening+=opening;totals.received+=received;totals.returnsQty+=returnsQty;totals.hospitality+=hospitality;
      totals.transferIn+=transferIn;totals.transferOut+=transferOut;totals.expected+=expected;totals.sold+=sold;totals.ending+=ending;
      if(actual!==null)totals.actual+=actual;if(difference!==null)totals.difference+=difference;
    });
  }else{
    (state.dailyRows||[]).forEach(function(row){
      if(String(getRowValue(row,'category','التصنيف')||'').trim()==='الشمع')return;
      const opening=num(getRowValue(row,'opening','openingBalance','رصيد أول المدة'));
      const received=num(getRowValue(row,'received','المستلم'));
      const returnsQty=num(getRowValue(row,'returnsQty','returns','المرتجعات'));
      const hospitality=num(getRowValue(row,'hospitality','الضيافة'));
      const sold=num(getRowValue(row,'sold','المباع'));
      const actualRaw=getRowValue(row,'actual','actualCount','الجرد الفعلي');
      const actual=actualRaw===''||actualRaw==null?null:num(actualRaw);
      const transferIn=num(getRowValue(row,'transferIn')),transferOut=num(getRowValue(row,'transferOut'));
      const expected=opening+received-returnsQty-hospitality+transferIn-transferOut,ending=expected-sold,difference=actual===null?null:actual-ending;
      totals.opening+=opening;totals.received+=received;totals.returnsQty+=returnsQty;totals.hospitality+=hospitality;totals.transferIn+=transferIn;totals.transferOut+=transferOut;totals.expected+=expected;totals.sold+=sold;totals.ending+=ending;
      if(actual!==null)totals.actual+=actual;if(difference!==null)totals.difference+=difference;
    });
  }
