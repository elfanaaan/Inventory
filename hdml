  async function approveTransferAction(
    transferCode,
    approve
  ) {

    let rejectionReason =
      "";


    if (!approve) {

      rejectionReason =
        await showPrompt(
          "اكتب سبب رفض التحويل:"
        );


      if (
        rejectionReason === null ||
        !rejectionReason.trim()
      ) {

        toast(
          "يجب كتابة سبب الرفض",
          "warning"
        );

        return;

      }

    }


    if (approve) {

      if (
        !await showConfirm(
          "هل تريد الموافقة على هذا التحويل؟\nسيتم خصم الكمية من الفرع المحوّل وإضافتها للفرع المستلم."
        )
      ) {

        return;

      }

    }


    try {

      const result =
        await server(
          "approveTransfer",
          {

            transferCode:
              transferCode,

            approve:
              approve,

            rejectionReason:
              rejectionReason

          },
          state.token
        );


      if (
        result &&
        result.success === false
      ) {

        toast(
          result.message ||
          "تعذر تنفيذ القرار",
          "error"
        );

        return;

      }


      toast(
        result?.message ||
        (
          approve
            ? "تمت الموافقة وترحيل التحويل"
            : "تم رفض التحويل"
        ),
        "success"
      );


      await loadTransfers();


      if (
        state.currentPage ===
        "daily"
      ) {

        await loadDailyInventory();

      }

    } catch (error) {

      toast(
        error.message ||
        "حدث خطأ أثناء اعتماد التحويل",
        "error"
      );

    }

  }


