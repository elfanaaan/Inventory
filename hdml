  async function createNewTransfer() {

    // التاريخ المعتمد للتحويل هو تاريخ الجرد المختار في الشاشة الرئيسية،
    // وليس التاريخ الافتراضي المنفصل الذي قد يظل على تاريخ اليوم.
    const dailyDateInput = document.getElementById("dailyDate");
    const transferDateInput = document.getElementById("transferDate");
    const date = String(dailyDateInput?.value || "").trim();
    if (transferDateInput && date) transferDateInput.value = date;


    const itemCode =
      document.getElementById(
        "transferItem"
      ).value;


    const quantity =
      Number(
        document.getElementById(
          "transferQty"
        ).value
      );


    const toBranch =
      document.getElementById(
        "transferToBranch"
      ).value;


    const reason =
      document.getElementById(
        "transferReason"
      ).value.trim();


    if (!date) {

      toast(
        "اختر تاريخ التحويل",
        "warning"
      );

      return;

    }


    if (!itemCode) {

      toast(
        "اختر الصنف",
        "warning"
      );

      return;

    }


    if (
      !Number.isFinite(
        quantity
      ) ||
      quantity <= 0
    ) {

      toast(
        "أدخل كمية صحيحة",
        "warning"
      );

      return;

    }


    if (
      state.currentTransferType ===
      "فرع→فرع" &&
      !toBranch
    ) {

      toast(
        "اختر الفرع المستلم",
        "warning"
      );

      return;

    }


    if (
      state.currentTransferType !==
      "فرع→فرع" &&
      !reason
    ) {

      toast(
        "سبب التحويل مطلوب",
        "warning"
      );

      return;

    }


    try {

      const result =
        await server(
          "createTransfer",
          {

            date:
              date,

            transferType:
              state.currentTransferType,

            fromBranch:
              getUserBranch(),

            toBranch:
              state.currentTransferType ===
              "فرع→فرع"
                ? toBranch
                : "",

            itemCode:
              itemCode,

            quantity:
              quantity,

            reason:
              reason

          },
          state.token
        );


      if (
        result &&
        result.success === false
      ) {

        toast(
          result.message ||
          "تعذر إنشاء التحويل",
          "error"
        );

        return;

      }


      toast(
        result?.message ||
        (
          state.currentTransferType ===
          "فرع→فرع"

            ? "تم إرسال التحويل وينتظر موافقة الفرع المستلم"

            : "تم ترحيل التحويل بنجاح"
        ),
        "success"
      );


      document
        .getElementById(
          "transferQty"
        )
        .value = "";


      document
        .getElementById(
          "transferReason"
        )
        .value = "";


      await loadTransfers();

    } catch (error) {

      toast(
        error.message ||
        "حدث خطأ أثناء إنشاء التحويل",
        "error"
      );

    }

  }


