

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#173d35">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <title>نظام الجرد - زنوبيا</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --primary: #173f5f;
      --primary-dark: #0d2d46;
      --secondary: #20639b;
      --success: #198754;
      --danger: #dc3545;
      --warning: #d39e00;
      --light: #f5f7fa;
      --border: #dfe4ea;
      --text: #25313c;
      --muted: #6c757d;
      --white: #ffffff;
      --shadow: 0 2px 12px rgba(0,0,0,.08);
    }

    body {
      margin: 0;
      font-family: "Tahoma", "Arial", sans-serif;
      background: var(--light);
      color: var(--text);
    }

    button,
    input,
    select,
    textarea {
      font-family: inherit;
    }

    .hidden {
      display: none !important;
    }

    /* =========================
       شاشة الدخول
       ========================= */

    #loginScreen {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background:
        linear-gradient(rgba(13,45,70,.88), rgba(13,45,70,.94)),
        #173f5f;
    }

    .login-card {
      width: min(430px, 100%);
      background: #fff;
      border-radius: 18px;
      padding: 35px 30px;
      box-shadow: 0 15px 50px rgba(0,0,0,.25);
      text-align: center;
    }

    .login-logo {
      width: 110px;
      height: 110px;
      object-fit: contain;
      margin: 0 auto 15px;
      display: block;
    }

    .login-title {
      font-size: 30px;
      font-weight: 800;
      color: var(--primary);
      margin: 5px 0;
    }

    .company-name {
      font-size: 15px;
      color: var(--muted);
      margin-bottom: 28px;
      line-height: 1.7;
    }

    .form-group {
      margin-bottom: 16px;
      text-align: right;
    }

    .form-group label {
      display: block;
      margin-bottom: 7px;
      font-weight: bold;
      font-size: 14px;
    }

    .form-control {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 13px;
      font-size: 15px;
      outline: none;
      background: #fff;
    }

    .form-control:focus {
      border-color: var(--secondary);
      box-shadow: 0 0 0 3px rgba(32,99,155,.10);
    }

    .btn {
      border: 0;
      border-radius: 7px;
      padding: 10px 17px;
      cursor: pointer;
      font-weight: bold;
      transition: .2s;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-secondary {
      background: #6c757d;
      color: #fff;
    }

    .btn-success {
      background: var(--success);
      color: #fff;
    }

    .btn-danger {
      background: var(--danger);
      color: #fff;
    }

    .btn-warning {
      background: #ffc107;
      color: #212529;
    }

    .btn-info {
      background: var(--secondary);
      color: #fff;
    }

    .btn-light {
      background: #eef2f6;
      color: var(--text);
    }

    .btn-lg {
      width: 100%;
      padding: 13px;
      font-size: 16px;
    }

    /* =========================
       التطبيق
       ========================= */

    #app {
      min-height: 100vh;
      display: flex;
    }

    .sidebar {
      width: 245px;
      background: var(--primary-dark);
      color: white;
      position: fixed;
      right: 0;
      top: 0;
      bottom: 0;
      overflow-y: auto;
      z-index: 100;
    }

    .sidebar-header {
      padding: 18px 15px;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,.12);
    }

    .sidebar-logo {
      width: 75px;
      height: 75px;
      object-fit: contain;
      background: #fff;
      border-radius: 50%;
      padding: 4px;
      margin-bottom: 8px;
    }

    .sidebar-title {
      font-weight: bold;
      font-size: 17px;
    }

    .sidebar-user {
      font-size: 12px;
      opacity: .75;
      margin-top: 5px;
    }

    .nav-section {
      padding: 12px 12px 5px;
      color: #aebdca;
      font-size: 11px;
      font-weight: bold;
    }

    .nav-item {
      padding: 11px 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: .2s;
      font-size: 14px;
    }

    .nav-item:hover,
    .nav-item.active {
      background: rgba(255,255,255,.12);
      border-right: 4px solid #fff;
    }

    .logout {
      margin: 20px 12px;
      background: rgba(220,53,69,.16);
      border-radius: 7px;
      justify-content: center;
    }

    .main {
      margin-right: 245px;
      width: calc(100% - 245px);
      min-height: 100vh;
    }

    .topbar {
      background: white;
      min-height: 65px;
      box-shadow: var(--shadow);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 22px;
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .page-title {
      font-size: 21px;
      font-weight: bold;
    }

    .top-user {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
    }

    .badge {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
    }

    .badge-success {
      background: #d1e7dd;
      color: #0f5132;
    }

    .badge-warning {
      background: #fff3cd;
      color: #664d03;
    }

    .badge-danger {
      background: #f8d7da;
      color: #842029;
    }

    .badge-info {
      background: #cff4fc;
      color: #055160;
    }

    .content {
      padding: 22px;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    /* =========================
       الكروت
       ========================= */

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 20px;
    }

    .card {
      background: white;
      border-radius: 10px;
      box-shadow: var(--shadow);
      padding: 18px;
    }

    .stat-card .label {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 8px;
    }

    .stat-card .value {
      font-size: 28px;
      font-weight: bold;
      color: var(--primary);
    }

    /* =========================
       الأدوات
       ========================= */

    .toolbar {
      background: white;
      padding: 15px;
      border-radius: 10px;
      box-shadow: var(--shadow);
      margin-bottom: 15px;
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 10px;
    }

    .toolbar-item {
      min-width: 150px;
    }

    .toolbar-item label {
      display: block;
      font-size: 12px;
      font-weight: bold;
      margin-bottom: 5px;
    }

    .toolbar-actions {
      display: flex;
      gap: 7px;
      align-items: center;
      flex-wrap: wrap;
    }

    /* =========================
       الجداول
       ========================= */

    .table-card {
      background: white;
      border-radius: 10px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .table-header {
      padding: 14px 17px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .table-title {
      font-weight: bold;
    }

    .table-wrapper {
      width: 100%;
      overflow: auto;
      max-height: calc(100vh - 250px);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 1100px;
      font-size: 12px;
    }

    th {
      background: #edf2f7;
      color: #25313c;
      font-weight: bold;
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 5;
      border: 1px solid #d8dee5;
      padding: 9px 7px;
      text-align: center;
    }

    td {
      border: 1px solid #e1e5e9;
      padding: 6px;
      text-align: center;
      white-space: nowrap;
    }

    tbody tr:hover {
      background: #f8fafc;
    }

    .item-name-cell {
      text-align: center !important;
      vertical-align: middle !important;
      font-weight: 800 !important;
      font-size: 15px !important;
      color: #34451f !important;
      min-width: 190px;
      white-space: normal !important;
      line-height: 1.45;
    }
    .metric-chart { display:grid; gap:10px; padding:16px 18px; }
    .metric-bar-row { display:grid; grid-template-columns:minmax(95px,150px) 1fr 72px; gap:10px; align-items:center; }
    .metric-bar-label { color:#34451f; font-weight:800; font-size:13px; }
    .metric-bar-track { height:18px; background:#edf1e8; border-radius:20px; overflow:hidden; }
    .metric-bar-fill { height:100%; background:linear-gradient(90deg,#7c8b45,#c5a059); border-radius:20px; min-width:0; }
    .metric-bar-value { text-align:left; font-weight:800; font-variant-numeric:tabular-nums; }

    .section-row td {
      background: #dce7f0;
      font-weight: bold;
      text-align: right;
      font-size: 13px;
      padding: 9px;
    }

    .number-input {
      width: 82px;
      min-width: 70px;
      padding: 6px;
      border: 1px solid #ccd3da;
      border-radius: 5px;
      text-align: center;
    }

    .readonly-number {
      font-weight: bold;
    }

    .positive {
      color: var(--success);
      font-weight: bold;
    }

    .negative {
      color: var(--danger);
      font-weight: bold;
    }

    .zero {
      color: #6c757d;
    }

    /* =========================
       التحويل
       ========================= */

    .transfer-type {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 18px;
    }

    .transfer-option {
      border: 2px solid var(--border);
      border-radius: 9px;
      padding: 14px;
      cursor: pointer;
      text-align: center;
      background: white;
    }

    .transfer-option.active {
      border-color: var(--secondary);
      background: #edf6fc;
    }

    .transfer-option strong {
      display: block;
      margin-bottom: 5px;
    }

    .transfer-option small {
      color: var(--muted);
    }

    .transfer-form {
      background: white;
      padding: 18px;
      border-radius: 10px;
      box-shadow: var(--shadow);
      margin-bottom: 18px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .form-grid .full {
      grid-column: 1 / -1;
    }

    /* =========================
       التنبيهات
       ========================= */

    #toastContainer {
      position: fixed;
      left: 20px;
      bottom: 20px;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-width: 420px;
    }

    .toast {
      background: #212529;
      color: white;
      padding: 13px 16px;
      border-radius: 7px;
      box-shadow: 0 5px 20px rgba(0,0,0,.2);
      animation: toastIn .2s ease;
      font-size: 13px;
    }

    .toast.success {
      background: var(--success);
    }

    .toast.error {
      background: var(--danger);
    }

    .toast.warning {
      background: #9a7400;
    }

    @keyframes toastIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* =========================
       تحميل
       ========================= */

    #loading {
      position: fixed;
      inset: 0;
      background: rgba(255,255,255,.75);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 10000;
      backdrop-filter: blur(2px);
    }

    .loader-box {
      background: white;
      padding: 25px 35px;
      border-radius: 10px;
      box-shadow: var(--shadow);
      text-align: center;
    }

    .spinner {
      width: 35px;
      height: 35px;
      border: 4px solid #e5e9ee;
      border-top-color: var(--secondary);
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin: 0 auto 12px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* =========================
       الطباعة
       ========================= */

    .print-only {
      display: none;
    }

    @media print {

      @page {
        size: A4 landscape;
        margin: 10mm;
      }

      body {
        background: white !important;
      }

      #loginScreen,
      .sidebar,
      .topbar,
      .toolbar,
      .no-print,
      button {
        display: none !important;
      }

      #app {
        display: block;
      }

      .main {
        margin: 0;
        width: 100%;
      }

      .content {
        padding: 0;
      }

      .page {
        display: none !important;
      }

      .page.printing {
        display: block !important;
      }

      .table-card {
        box-shadow: none;
        border: 0;
      }

      .table-wrapper {
        overflow: visible;
        max-height: none;
      }

      table {
        min-width: 0;
        font-size: 8px;
      }

      th {
        position: static;
        background: #eee !important;
      }

      td,
      th {
        padding: 3px;
      }

      .print-only {
        display: block;
      }

      .print-header {
        text-align: center;
        margin-bottom: 12px;
      }

      .print-header img {
        width: 60px;
        height: 60px;
        object-fit: contain;
      }

      .print-header h1 {
        font-size: 18px;
        margin: 3px 0;
      }

      .print-header h2 {
        font-size: 14px;
        margin: 3px 0;
      }

      tr {
        page-break-inside: avoid;
      }
    }

    @media (max-width: 1000px) {

      .sidebar {
        width: 210px;
      }

      .main {
        margin-right: 210px;
        width: calc(100% - 210px);
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .form-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 700px) {

      .sidebar {
        display: none;
      }

      .main {
        margin-right: 0;
        width: 100%;
      }

      .content {
        padding: 10px;
      }

      .cards {
        grid-template-columns: 1fr 1fr;
      }

      .transfer-type {
        grid-template-columns: 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }
    }

    /* =========================================================
       الواجهة الاحترافية - الإصدار الجديد
       ========================================================= */
    :root {
      --primary: #12344d;
      --primary-dark: #08263a;
      --secondary: #0f7890;
      --accent: #d4a24c;
      --accent-soft: #f5ead6;
      --surface: #ffffff;
      --page: #f3f7fa;
      --text: #173042;
      --muted: #70808d;
      --border: #dce6ec;
      --shadow: 0 10px 30px rgba(18,52,77,.08);
    }
    body { background: var(--page); color: var(--text); }
    #loginScreen {
      position: relative; overflow: hidden; padding: 28px;
      background: radial-gradient(circle at 15% 20%, rgba(212,162,76,.20), transparent 30%),
                  radial-gradient(circle at 85% 80%, rgba(15,120,144,.22), transparent 32%),
                  linear-gradient(135deg,#08263a 0%,#12344d 55%,#0c667b 100%);
    }
    #loginScreen::before, #loginScreen::after { content:""; position:absolute; border-radius:50%; filter:blur(2px); opacity:.18; pointer-events:none; }
    #loginScreen::before { width:360px;height:360px;right:-130px;top:-120px;border:1px solid #fff;box-shadow:0 0 0 50px rgba(255,255,255,.03),0 0 0 100px rgba(255,255,255,.02); }
    #loginScreen::after { width:300px;height:300px;left:-140px;bottom:-120px;border:1px solid var(--accent); }
    .login-card {
      position:relative; z-index:2; width:min(470px,100%); padding:38px 36px 34px;
      border:1px solid rgba(255,255,255,.7); border-radius:26px;
      background:rgba(255,255,255,.97); box-shadow:0 28px 80px rgba(0,0,0,.30);
    }
    .login-card::before { content:""; display:block; height:5px; border-radius:10px; margin:-38px -36px 28px; background:linear-gradient(90deg,var(--accent),#e8c47c,var(--secondary)); }
    .login-logo { width:118px;height:118px;border-radius:22px; padding:9px; background:#fff; box-shadow:0 10px 28px rgba(18,52,77,.13); }
    .login-title { font-size:34px; letter-spacing:-.5px; color:var(--primary); }
    .company-name { color:#617381; margin-bottom:25px; }
    .form-group label { color:#334c5d; }
    .form-control { min-height:48px; border-radius:12px; border-color:#d4e0e7; background:#fbfdfe; transition:.2s; }
    .form-control:hover { border-color:#b9ccd7; }
    .form-control:focus { border-color:var(--secondary); box-shadow:0 0 0 4px rgba(15,120,144,.10); background:#fff; }
    #loginBranchGroup { display:none !important; }
    #loginBranch { display:none !important; }
    .btn { border-radius:11px; box-shadow:0 5px 14px rgba(18,52,77,.08); }
    .btn-primary { background:linear-gradient(135deg,#12344d,#0f7890); }
    .btn-primary:hover { box-shadow:0 9px 22px rgba(15,120,144,.22); }
    #app { background:var(--page); }
    .sidebar { width:265px; background:linear-gradient(180deg,#08263a 0%,#0d354d 65%,#0b4f63 100%); box-shadow:-8px 0 30px rgba(0,0,0,.06); }
    .sidebar-header { padding:24px 18px 20px; background:linear-gradient(180deg,rgba(255,255,255,.06),transparent); }
    .sidebar-logo { width:78px;height:78px;border-radius:20px; padding:6px; box-shadow:0 8px 20px rgba(0,0,0,.18); }
    .sidebar-title { font-size:18px; }
    .nav-section { padding:18px 18px 7px; color:#a9c0cd; letter-spacing:.3px; }
    .nav-item { margin:3px 10px; padding:12px 15px; border-radius:10px; border-right:3px solid transparent; }
    .nav-item:hover,.nav-item.active { background:rgba(255,255,255,.10); border-right-color:var(--accent); }
    .logout { margin-top:25px; }
    .main { margin-right:265px; width:calc(100% - 265px); }
    .topbar { min-height:74px; padding:12px 28px; border-bottom:1px solid #e3ebef; }
    .page-title { color:var(--primary); font-size:23px; }
    .content { padding:28px; }
    .card,.toolbar,.table-card,.transfer-form { border:1px solid #e4edf2; border-radius:15px; box-shadow:var(--shadow); }
    .card { padding:20px; }
    .stat-card { position:relative; overflow:hidden; }
    .stat-card::after { content:""; position:absolute; width:90px;height:90px; border-radius:50%; background:var(--accent-soft); left:-30px;bottom:-35px; }
    .stat-card .value { color:var(--primary); }
    .toolbar { padding:17px; }
    .table-card { overflow:hidden; }
    .table-header { padding:17px 20px; background:linear-gradient(180deg,#fff,#fbfdfe); }
    th { background:#edf4f7; color:#17384d; border-color:#d7e3e9; }
    td { border-color:#e4ebef; }
    tbody tr:hover { background:#f3fafc; }
    .section-row td { background:linear-gradient(90deg,#e7f1f4,#f4f8fa); color:#123d54; }
    .transfer-option { border-radius:13px; transition:.2s; }
    .transfer-option:hover { transform:translateY(-2px); box-shadow:var(--shadow); }
    .transfer-option.active { border-color:var(--secondary); box-shadow:0 0 0 3px rgba(15,120,144,.08); background:#eff9fb; }
    #toastContainer { z-index:10001; }
    #loading { z-index:10000; }
    .loader-box { border:1px solid #e0e9ee; border-radius:15px; padding:28px 38px; }
    .spinner { border-top-color:var(--accent); }
    @media (max-width:1000px) { .sidebar{width:225px}.main{margin-right:225px;width:calc(100% - 225px)} }
    @media (max-width:700px) { .sidebar{display:none}.main{margin-right:0;width:100%}.login-card{padding:32px 22px}.login-card::before{margin:-32px -22px 25px} }

  
/* ===== إجماليات الأقسام: أزرق + ارتفاع أكبر + أرقام بيضاء ===== */
#dailyTableBody tr.section-total-row:not(.empty-total) {
  height: 48px !important;
  background: #12344d !important;
  color: #ffffff !important;
}
#dailyTableBody tr.section-total-row:not(.empty-total) td {
  background: #12344d !important;
  color: #ffffff !important;
  font-weight: 800 !important;
  font-size: 13px !important;
  padding: 12px 7px !important;
  border-color: #31566f !important;
  vertical-align: middle !important;
}
#dailyTableBody tr.section-total-row:not(.empty-total) strong {
  color: #ffffff !important;
  font-weight: 900 !important;
