  async function login() {
    const username = document.getElementById("loginUsername").value.trim();
    const password = document.getElementById("loginPassword").value;
    const branchCodeValue = document.getElementById("loginBranch").value;
    const button = document.getElementById("loginSubmit");
    const message = document.getElementById("loginMessage");
    if (message) message.textContent = "";
    if (!username) { if (message) message.textContent = "اكتب اسم المستخدم."; toast("اكتب اسم المستخدم", "warning"); return; }
    if (!password) { if (message) message.textContent = "اكتب كلمة المرور."; toast("اكتب كلمة المرور", "warning"); return; }

    if (button) { button.disabled = true; const label = button.querySelector("span"); if (label) label.textContent = "جارٍ التحقق…"; }
    try {
      const result = await server("loginUser", username, password, branchCodeValue);
      if (!result || !result.success) throw new Error((result && result.message) || "بيانات الدخول غير صحيحة.");
      state.token = result.token || result.sessionToken || null;
      state.user = result.user || result;
      if (!state.token) throw new Error("تعذر إنشاء جلسة آمنة. أعد المحاولة.");

      document.getElementById("loginScreen").classList.add("hidden");
      document.getElementById("app").classList.remove("hidden");
      try { configureUserInterface(); } catch (uiError) { console.error("فشل تجهيز الواجهة بعد نجاح تسجيل الدخول:", uiError); }
      if (isManager()) {
        // تحميل قوائم الأصناف والفروع أولاً؛ كل تبويبات الإدارة تعتمد عليها.
        // لا نبدأ تقارير لوحة الإدارة قبل اكتمال القائمتين.
        await loadAdminReferences();
        // تقرير لوحة الإدارة لا يمنع تسجيل الدخول أو فتح التبويبات.
        loadDashboard().catch(function(error){ console.error("فشل تقرير لوحة الإدارة:", error); });
      } else {
        await loadItems();
        await loadDailyInventory();
      }
      toast("تم تسجيل الدخول بنجاح", "success");
    } catch (error) {
      const msg = error && error.message ? error.message : "حدث خطأ أثناء تسجيل الدخول.";
      if (message) message.textContent = msg;
      toast(msg, "error");
    } finally {
      if (button) { button.disabled = false; const label = button.querySelector("span"); if (label) label.textContent = "دخول"; }
    }
  }

