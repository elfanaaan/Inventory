  function getVisibleCategorySplitItems_(){const s=document.getElementById('categorySplitSource')?.value||'',q=String(document.getElementById('categorySplitSearch')?.value||'').trim().toLocaleLowerCase();return (state.items||[]).filter(i=>String(itemCategory(i)||'').trim()===s&&(!q||String(itemName(i)||'').toLocaleLowerCase().includes(q)||String(itemCode(i)||'').toLocaleLowerCase().includes(q)));}
  function renderCategorySplitItems(){
