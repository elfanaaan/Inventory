async function saveDailyInventory(silent=false){
  if(!state.dailyRows.length){if(!silent)toast("لا توجد بيانات للحفظ","warning");return false;}
  if(!state.dailyDirty&&!window.__dailySaveQueued){if(!silent)toast("لا توجد تعديلات جديدة للحفظ","info");return true;}
  const date=document.getElementById("dailyDate")?.value,branch=getDailyBranchCode();
  if(!date||!branch){if(!silent)toast("يجب تحديد التاريخ والفرع","warning");return false;}
  if(window.__dailySaveInFlight){window.__dailySaveQueued=true;return false;}
  const rows=[];
  const saveRevision=window.__dailyEditRevision||0;
  let hospitalityMissing=false;
  document.querySelectorAll("#dailyTableBody tr[data-item-code]").forEach(tr=>{
    const hospitality=num(tr.querySelector(".daily-hospitality")?.value);
    const hospitalityBy=tr.querySelector(".daily-hospitality-by")?.value?.trim()||"";
    const hospitalityTo=tr.querySelector(".daily-hospitality-to")?.value?.trim()||"";
    if(hospitality>0&&(!hospitalityBy||!hospitalityTo)) hospitalityMissing=true;
    const openingInput=tr.querySelector(".daily-opening");
    rows.push({itemCode:tr.dataset.itemCode,opening:openingInput?num(openingInput.value):null,received:num(tr.querySelector(".daily-received")?.value),returnsQty:num(tr.querySelector(".daily-returns")?.value),hospitality:hospitality,hospitalityBy:hospitalityBy,hospitalityTo:hospitalityTo,sold:num(tr.querySelector(".daily-sold")?.value),actual:tr.querySelector(".daily-actual")?.value===""?null:Number(tr.querySelector(".daily-actual")?.value),notes:tr.querySelector(".daily-notes")?.value||""});
  });
  if(hospitalityMissing){if(!silent)toast("عند تسجيل كمية ضيافة، يجب إدخال «بأمر من» و«لمن» في الصف نفسه.","warning");return false;}
  let changeReason=document.getElementById("dailyChangeReason")?.value?.trim()||"";
  if(!changeReason&&!silent){const prompted=await showPrompt("اكتب سبب التعديل قبل حفظ بيانات الجرد:");if(prompted===null||!prompted.trim())return false;changeReason=prompted.trim();const reasonInput=document.getElementById("dailyChangeReason");if(reasonInput)reasonInput.value=changeReason;}
  if(!changeReason&&silent){const reasonStatus=document.getElementById("dailySaveStatus");if(reasonStatus){reasonStatus.textContent="اكتب سبب التعديل ثم اضغط حفظ الجرد";reasonStatus.className="badge badge-warning";}return false;}
  window.__dailySaveInFlight=true;
  const status=document.getElementById("dailySaveStatus");
  if(status){status.textContent="جارٍ حفظ التعديلات…";status.className="badge badge-info";}
  try{
    const result=await serverQuiet("saveDailyInventoryBatch",{date,branchCode:branch,submittedBy:state.user?.userName||state.user?.username||"",changeReason:changeReason,items:rows,rows},state.token);
    if(!result || result.success!==true) throw new Error(result?.message||"لم يؤكد الخادم نجاح حفظ الجرد");
    document.querySelectorAll('#dailyTableBody .daily-opening[data-opening-edited="1"]').forEach(function(input){const span=document.createElement('span');span.className='readonly-number';span.textContent=fmt(input.value);input.replaceWith(span);});
    state.dailyDirty=(window.__dailyEditRevision||0)!==saveRevision;
    clearTimeout(window.__dailyAutosaveTimer);
    if(status){status.textContent=state.dailyDirty?"تم حفظ الدفعة السابقة — جارٍ حفظ أحدث التعديلات":"تم الحفظ";status.className=state.dailyDirty?"badge badge-warning":"badge badge-success";}
    if(!state.dailyDirty){const reasonInput=document.getElementById("dailyChangeReason");if(reasonInput)reasonInput.value="";}
    if(!silent)toast(result?.message||"تم حفظ الجرد بنجاح","success");
    return !state.dailyDirty;
  }catch(e){
    if(status){status.textContent="تعذر الحفظ — ستتم إعادة المحاولة";status.className="badge badge-warning";}
    if(!silent)toast(e.message||"حدث خطأ أثناء حفظ الجرد","error");
    return false;
  }finally{
    window.__dailySaveInFlight=false;
    if(window.__dailySaveQueued){window.__dailySaveQueued=false;if(state.dailyDirty)markDailyDirtyRetry();}
    else if(state.dailyDirty)markDailyDirtyRetry();
  }
}

function markDailyDirty(){
  window.__dailyEditRevision=(window.__dailyEditRevision||0)+1;
  state.dailyDirty=true;
  const b=document.getElementById("dailySaveStatus");if(b){b.textContent="تعديلات غير محفوظة — الحفظ التلقائي خلال 10 ثوانٍ";b.className="badge badge-warning";}
  clearTimeout(window.__dailyAutosaveTimer);
  window.__dailyAutosaveTimer=setTimeout(async function(){
    if(!state.dailyDirty||window.__dailySaveInFlight)return;
    await saveDailyInventory(true);
    if(state.dailyDirty)markDailyDirtyRetry();
  },10000);
}

function markDailyDirtyRetry(){clearTimeout(window.__dailyAutosaveTimer);const reason=document.getElementById("dailyChangeReason")?.value?.trim()||"";if(state.dailyDirty&&!reason)return;window.__dailyAutosaveTimer=setTimeout(async function(){if(state.dailyDirty&&!window.__dailySaveInFlight){await saveDailyInventory(true);if(state.dailyDirty&&document.getElementById("dailyChangeReason")?.value?.trim())markDailyDirtyRetry();}},10000);}
function startAutosave(){return true;}

