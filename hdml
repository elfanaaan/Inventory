    const possibleSources = [

      data.branches,

      data.fbranches,

      data.branchList,

      data.branchRows,

      data.rows,

      data.data

    ];


    for (
      const source of possibleSources
    ) {

      if (
        Array.isArray(source) &&
        source.length
      ) {

        const branches =
          cleanBranches(source);

        if (branches.length) {
          return branches;
        }

      }

    }


    return [];

  }


  function extractItems(data) {

    if (!data) {
