function updateDailyRow(element){
  // Recalculate synchronously on every input event, including clearing a field.
  const tr=element&&element.closest?element.closest('tr.daily-item-row[data-item-code]'):null;
  if(!tr)return;
  const code=String(tr.dataset.itemCode||'');
  const row=(state.dailyRows||[]).find(r=>String(getRowValue(r,'itemCode','كود الصنف')||'')===code);
  if(!row)return;
  const read=selector=>{const el=tr.querySelector(selector);return el?el.value:'';};
  const openingInput=tr.querySelector('.daily-opening');
  const opening=openingInput?num(openingInput.value):num(getRowValue(row,'opening','openingBalance','رصيد أول المدة'));
  const received=num(read('.daily-received'));
  const returnsQty=num(read('.daily-returns'));
  const hospitality=num(read('.daily-hospitality'));
  const sold=num(read('.daily-sold'));
  const actualRaw=read('.daily-actual');
  const actual=actualRaw===''?null:num(actualRaw);
  const info=dailyTransferInfo(code);
  const transferIn=info.incoming.reduce((sum,t)=>sum+num(t.qty)*(t.pending?0:1),0);
  const transferOut=info.outgoing.reduce((sum,t)=>sum+num(t.qty)*(t.pending?0:1),0);
  const expected=opening+received-returnsQty-hospitality+transferIn-transferOut;
  const ending=expected-sold;
  const difference=actual===null?null:actual-ending;

  // Keep the in-memory row aligned with the visible inputs. This is essential
  // when a value is erased: blank numeric input means zero immediately.
  Object.assign(row,{opening,received,returnsQty,hospitality,
    hospitalityBy:read('.daily-hospitality-by').trim(),
    hospitalityTo:read('.daily-hospitality-to').trim(),
    transferIn,transferOut,expected,sold,ending,actual,difference});
  const expectedCell=tr.querySelector('.expected-cell');
  const endingCell=tr.querySelector('.ending-cell');
  const differenceCell=tr.querySelector('.difference-cell');
  if(expectedCell)expectedCell.textContent=fmt(expected);
  if(endingCell)endingCell.textContent=fmt(ending);
  if(differenceCell){
    differenceCell.textContent=difference===null?'':fmt(difference);
    differenceCell.className='readonly-number difference-cell '+(difference===null?'':difference>0?'positive':difference<0?'negative':'zero');
  }
  tr.dataset.hasMovement=(opening!==0||received!==0||returnsQty!==0||hospitality!==0||transferIn!==0||transferOut!==0||sold!==0||actual!==null||String(read('.daily-notes')).trim()!=='')?'1':'0';
  tr.classList.toggle('print-empty',tr.dataset.hasMovement!=='1');
  refreshCategoryTotalsFromDOM();
  markDailyDirty();
}

function refreshCategoryTotalsFromDOM(){
  const tbody=document.getElementById('dailyTableBody'); if(!tbody)return;
  const allRows=Array.from(tbody.querySelectorAll('tr.daily-item-row[data-item-code]'));
  tbody.querySelectorAll('tr[data-category-total]').forEach(function(totalRow){
    const category=String(totalRow.dataset.categoryTotal||'');
    const totals={opening:0,received:0,returnsQty:0,hospitality:0,transferIn:0,transferOut:0,expected:0,sold:0,ending:0,actual:0,difference:0};
    let hasMovement=false;
    allRows.filter(tr=>String(tr.dataset.category||'')===category).forEach(function(tr){
      const read=function(selector){const el=tr.querySelector(selector);return el?el.value:'';};
      const row=state.dailyRows.find(function(r){return String(getRowValue(r,'itemCode','كود الصنف')||'')===String(tr.dataset.itemCode||'');})||{};
      const openingRaw=read('.daily-opening');
      const opening=num(openingRaw!==''?openingRaw:getRowValue(row,'opening','openingBalance','رصيد أول المدة'));
      const received=num(read('.daily-received'));
      const returnsQty=num(read('.daily-returns'));
      const hospitality=num(read('.daily-hospitality'));
      const sold=num(read('.daily-sold'));
      const actualRaw=read('.daily-actual');
      const actual=actualRaw===''?null:num(actualRaw);
      const info=dailyTransferInfo(tr.dataset.itemCode);
      const transferIn=info.incoming.reduce((a,t)=>a+num(t.qty)*(t.pending?0:1),0);
      const transferOut=info.outgoing.reduce((a,t)=>a+num(t.qty)*(t.pending?0:1),0);
      const expected=opening+received-returnsQty-hospitality+transferIn-transferOut;
      const ending=expected-sold;
      const difference=actual===null?null:actual-ending;
      totals.opening+=opening; totals.received+=received; totals.returnsQty+=returnsQty;
      totals.hospitality+=hospitality; totals.transferIn+=transferIn; totals.transferOut+=transferOut;
      totals.expected+=expected; totals.sold+=sold; totals.ending+=ending;
      if(actual!==null)totals.actual+=actual;
      if(difference!==null)totals.difference+=difference;
      if(opening||received||returnsQty||hospitality||transferIn||transferOut||sold||actual!==null||String(read('.daily-notes')).trim())hasMovement=true;
    });
    const cells=totalRow.children;
    // الخلية الأولى تمتد على الأعمدة 1-3؛ باقي القيم تبدأ من العمود الرابع.
    const values=[totals.opening,totals.received,totals.returnsQty,totals.hospitality,totals.transferIn,null,totals.transferOut,null,totals.expected,totals.sold,totals.ending,totals.actual,totals.difference];
    values.forEach(function(value,index){if(value!==null&&cells[index+1])cells[index+1].textContent=fmt(value);});
    totalRow.classList.toggle('empty-total',!hasMovement);
  });
  const grand=tbody.querySelector('tr.daily-grand-total-row');
  if(grand) grand.outerHTML=buildDailyGrandTotalExcludingWax();
}

