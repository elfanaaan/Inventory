<script>
(function(){
  const table = document.getElementById("dailyTable");
  let zoom = Number(localStorage.getItem("zanobiaDailyZoom")) || 1;

  window.applyDailyZoom = function(){
    table.style.zoom = zoom;
    document.getElementById("dailyZoomValue").textContent =
      Math.round(zoom * 100) + "%";
  };

  window.changeDailyZoom = function(amount){
    zoom = Math.min(1.5, Math.max(0.7, zoom + amount));
    zoom = Math.round(zoom * 10) / 10;
    localStorage.setItem("zanobiaDailyZoom", zoom);
    applyDailyZoom();
  };

  window.resetDailyZoom = function(){
    zoom = 1;
    localStorage.setItem("zanobiaDailyZoom", zoom);
    applyDailyZoom();
  };

  applyDailyZoom();
})();
