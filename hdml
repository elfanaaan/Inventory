  const categorySplitSelectedCodes = new Set();
  function renderCategorySplitTool(){
    const source=document.getElementById('categorySplitSource'),target=document.getElementById('categorySplitTarget');
    if(!source||!target)return;
    const oldS=source.value,oldT=target.value,cats=Array.isArray(state.categories)?state.categories:[];
    const sources=cats.filter(c=>(state.items||[]).some(i=>String(itemCategory(i)||'').trim()===String(c.name||'')));
    const preferred=sources.some(c=>c.name==='الجاتوه')?'الجاتوه':(sources[0]?.name||'');
    const current=sources.some(c=>c.name===oldS)?oldS:preferred;
    source.innerHTML='<option value="">اختر تصنيف المصدر</option>'+sources.map(c=>`<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)}</option>`).join('');source.value=current;
    const targets=cats.filter(c=>c.name&&c.name!==current);
    target.innerHTML='<option value="">اختر التصنيف الهدف</option>'+targets.map(c=>`<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)}</option>`).join('');target.value=targets.some(c=>c.name===oldT)?oldT:'';
    renderCategorySplitItems();
  }
