    const button = Array.from(document.querySelectorAll('#itemsBody button[data-item-status-code]')).find(function(btn){return String(btn.dataset.itemStatusCode || '') === String(code);});
    if (button) { button.disabled = true; button.textContent = "جارٍ التحديث..."; }
