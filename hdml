  const APP = {

    companyName:
      "الدولية للاستثمار والتجارة والتوزيع (زنوبيا)",

    logo:
      "https://forasna-images.wuzzuf-data.net/uploads/logos/thumb_clogo_2021-06-15-10-24-57_ReXp3IImYFB0CSsFHnr63wXX.jpg"

  };


  /* =========================================================
     حالة التطبيق
     ========================================================= */

  let state = {

    token: null,

    user: null,

    branches: [],

    items: [],

    categories: [],

    dailyRows: [],

    dailyTransfers: [],

    dailyDirty: false,

    currentTransferType: "فرع→فرع",

    currentPage: "daily"

  };


  /* =========================================================
     Google Apps Script
     ========================================================= */

  function server(functionName, ...args) {
    return new Promise((resolve, reject) => {
      const trackLoading = !window.__initializing;
      if (trackLoading) {
        window.__serverPendingCount = (window.__serverPendingCount || 0) + 1;
        showLoading();
      }

      let settled = false;
      let timeoutId = null;
      const finish = (callback, value) => {
        if (settled) return;
        settled = true;
        if (timeoutId) clearTimeout(timeoutId);
        if (trackLoading) {
          window.__serverPendingCount = Math.max(0, (window.__serverPendingCount || 1) - 1);
          if (window.__serverPendingCount === 0) hideLoading();
        }
        callback(value);
      };

      timeoutId = setTimeout(() => {
        console.error("انتهت مهلة طلب Apps Script:", functionName);
        finish(reject, new Error("تأخر رد الخادم أثناء تنفيذ: " + functionName + ". تحقق من اتصال الإنترنت وسجل التنفيذ في Apps Script ثم أعد المحاولة."));
      }, 45000);

      if (typeof google === "undefined" || !google.script || !google.script.run) {
        finish(reject, new Error("تعذر الاتصال بخدمة Google Apps Script"));
        return;
      }

      try {
        google.script.run
          .withSuccessHandler(result => finish(resolve, result))
          .withFailureHandler(error => {
            const detail = error && error.message ? error.message : String(error || "فشل غير محدد من الخادم");
            console.error("خطأ من Apps Script (" + functionName + "):", detail, error);
            finish(reject, error instanceof Error ? error : new Error(detail || ("فشل طلب الخادم: " + functionName)));
          })[functionName](...args);
      } catch (error) {
        finish(reject, error);
      }
    });
  }


  // طلبات الحفظ التلقائي لا تُظهر طبقة تحميل تغطي الشاشة؛ يظل مؤشر الحفظ داخل الجرد هو المرجع للمستخدم.
  function serverQuiet(functionName, ...args) {
    return new Promise((resolve, reject) => {
      if (typeof google === "undefined" || !google.script || !google.script.run) {
        reject(new Error("تعذر الاتصال بخدمة Google Apps Script"));
        return;
      }
      let settled = false;
      const timeoutId = setTimeout(() => {
        if (settled) return;
        settled = true;
        reject(new Error("تأخر رد الخادم أثناء حفظ الجرد. ستتم إعادة المحاولة تلقائيًا."));
      }, 45000);
      const finish = (fn, value) => {
        if (settled) return;
        settled = true;
        clearTimeout(timeoutId);
        fn(value);
      };
      try {
        google.script.run
          .withSuccessHandler(result => finish(resolve, result))
          .withFailureHandler(error => finish(reject, error instanceof Error ? error : new Error(error && error.message ? error.message : String(error || "فشل حفظ الجرد"))))
          [functionName](...args);
      } catch (error) { finish(reject, error); }
    });
  }

  /* =========================================================
     أدوات عامة
     ========================================================= */

  function showLoading(
    text = "جاري التنفيذ..."
  ) {

    const textElement =
      document.getElementById(
        "loadingText"
      );

    const loading =
      document.getElementById(
        "loading"
      );

    if (textElement) {
      textElement.textContent = text;
    }

    if (loading) {
      loading.style.display = "flex";
    }

  }


  function hideLoading() {

    const loading =
      document.getElementById(
        "loading"
      );

    if (loading) {
      loading.style.display = "none";
    }

  }


  function showZenDialog(options) {
    options = options || {};
    return new Promise(function(resolve) {
      const backdrop = document.createElement('div');
      backdrop.className = 'zen-dialog-backdrop';
      backdrop.setAttribute('role', 'presentation');
      const dialog = document.createElement('div');
      dialog.className = 'zen-dialog';
      dialog.setAttribute('role', 'dialog');
      dialog.setAttribute('aria-modal', 'true');
