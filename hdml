async function loadDailyInventory(){
  const date=document.getElementById('dailyDate')?.value;
  if(!date){toast('اختر تاريخ الجرد','warning');return;}
  const branch=getDailyBranchCode();
  if(!branch){toast('لم يتم تحديد الفرع','error');return;}
  const requestDate=date, requestBranch=branch, requestId=(window.__dailyRequestId||0)+1; window.__dailyRequestId=requestId;
  try{
    // اقرأ ترتيب التصنيفات المعتمد من الخادم في كل تحميل للجرد، وانتظر اكتماله
    // قبل رسم الجدول؛ لا تعتمد على ترتيب قديم محفوظ في الواجهة أو على ترتيب الأصناف.
    const categoriesPromise = server('getCategories',state.token).then(function(categoryResult){
      state.categories=normalizeRows(categoryResult).map(function(c,index){
        if(Array.isArray(c))return {name:c[0],displayOrder:Number(c[1])||index+1,notes:c[3]||''};
        return {name:c.name??c.category??c['اسم التصنيف']??'',displayOrder:Number(c.displayOrder??c.order??c['ترتيب العرض'])||index+1,notes:c.notes??c['ملاحظات']??''};
      }).filter(c=>String(c.name||'').trim())
        .sort((a,b)=>(Number(a.displayOrder)||999999)-(Number(b.displayOrder)||999999));
    }).catch(function(categoryLoadError){console.warn('تعذر تحميل مرجع التصنيفات للجرد:',categoryLoadError);});
    const result = await server('getBranchDailyInventory',requestBranch,requestDate,state.token);
    await categoriesPromise;
    if(requestId!==window.__dailyRequestId || document.getElementById('dailyDate')?.value!==requestDate || getDailyBranchCode()!==requestBranch) return;
    const returnedRows=normalizeRows(result?.rows||[]);
    const returnedItems=normalizeRows(result?.items||state.items||[]).filter(item => isActiveItemStatus(getRowValue(item,'status','الحالة') || 'نشط'));
    // قائمة الأصناف المركزية هي المصدر الثابت. لا يجوز أن يؤدي تحويل أو قراءة مؤقتة
    // إلى إسقاط صنف من الشاشة. ندمج بيانات اليوم فوق قائمة الأصناف دائمًا.
    if(returnedItems.length){
      const byCode={};
      returnedRows.forEach(function(r){
        const c=String(getRowValue(r,'itemCode','كود الصنف')||'').trim();
        if(c) byCode[c]=r;
      });
      state.dailyRows=returnedItems.map(function(item){
        const code=String(getRowValue(item,'code','كود الصنف')||'').trim();
        const r=byCode[code]||{};
        return {
          itemCode:code,
          itemName:getRowValue(item,'name','اسم الصنف'),
          unit:getRowValue(item,'unit','الوحدة'),
          category:getRowValue(item,'category','التصنيف')||'',
          opening:num(getRowValue(r,'opening','openingBalance','رصيد أول المدة')),
          openingEditable:requestDate.endsWith('-01'),
          received:num(getRowValue(r,'received','المستلم')),
          returnsQty:num(getRowValue(r,'returnsQty','returns','المرتجعات')),
          hospitality:num(getRowValue(r,'hospitality','الضيافة')),
          hospitalityBy:getRowValue(r,'hospitalityBy','بأمر من','الضيافة بأمر من')||'',
          hospitalityTo:getRowValue(r,'hospitalityTo','لمن','الضيافة إلى')||'',
          transferIn:num(getRowValue(r,'transferIn','التحويل الوارد')),
          transferOut:num(getRowValue(r,'transferOut','التحويل المنصرف')),
          sold:num(getRowValue(r,'sold','المباع')),
          expected:num(getRowValue(r,'expected','الرصيد المتوقع')),
          ending:num(getRowValue(r,'ending','الرصيد الاخر','رصيد اخر')),
          actual:(getRowValue(r,'actual','actualCount','الجرد الفعلي')===''||getRowValue(r,'actual','actualCount','الجرد الفعلي')==null)?null:num(getRowValue(r,'actual','actualCount','الجرد الفعلي')),
          difference:(getRowValue(r,'difference','الفرق')===''||getRowValue(r,'difference','الفرق')==null)?null:num(getRowValue(r,'difference','الفرق')),
          notes:getRowValue(r,'notes','الملاحظات')||''
        };
      });
    }else if(returnedRows.length){
      state.dailyRows=returnedRows;
    }else if(!state.dailyRows.length){
      state.dailyRows=[];
    }
    state.dailyTransfers=normalizeRows(result?.transfers||[]);
    // مسار احتياطي: إذا أعاد تحميل الجرد أصنافًا لكن لم يُرجع التحويلات،
    // اقرأ التحويلات الخاصة بالفرع مباشرة. هذا يمنع اختفاء التحويل بسبب
    // اختلاف تصفية التاريخ داخل استجابة الجرد.
    if(!state.dailyTransfers.length){
      try{
        const transferResult=await server('getTransfersForUser',requestBranch,isManager()?'مدير النظام':(state.user?.role||'مسؤول فرع'),state.token);
        const rawTransfers=normalizeRows(transferResult);
        state.dailyTransfers=rawTransfers.filter(function(t){
          const d=dateKeyClient(getRowValue(t,'date','التاريخ'));
          const item=String(getRowValue(t,'itemCode','كود الصنف')||'').trim();
          const from=String(getRowValue(t,'fromBranch','الفرع المحوّل')||'').trim();
          const to=String(getRowValue(t,'toBranch','الفرع المستلم')||'').trim();
          return d===requestDate && !!item && (from===requestBranch || to===requestBranch);
        }).map(function(t){
          return {
            transferCode:getRowValue(t,'transferCode','كود التحويل'),
            date:dateKeyClient(getRowValue(t,'date','التاريخ')),
            fromBranch:getRowValue(t,'fromBranch','الفرع المحوّل'),
            toBranch:getRowValue(t,'toBranch','الفرع المستلم'),
            itemCode:getRowValue(t,'itemCode','كود الصنف'),
            quantity:getRowValue(t,'quantity','الكمية'),
            status:getRowValue(t,'status','الحالة'),
            requestedBy:getRowValue(t,'requestedBy','طالب التحويل')
          };
        });
      }catch(transferFallbackError){console.error('تعذر تحميل التحويلات بالمسار الاحتياطي:',transferFallbackError);}
    }
    try{const lockStatus=await server('getDailyInventoryDayStatus',requestBranch,requestDate,state.token);state.dailyDayClosed=!!lockStatus?.closed;}catch(lockError){console.warn('تعذر قراءة حالة إغلاق اليوم:',lockError);state.dailyDayClosed=false;}
    renderDailyTable();
    applyDailyLockState();
    const name=getBranchName(requestBranch), display=formatArabicDate(requestDate);
    const info=document.getElementById('dailyTableInfo'); if(info)info.textContent=` - ${name} - ${display}`;
    const pb=document.getElementById('dailyPrintBranch'); if(pb)pb.textContent=`جرد فرع ${name}`;
    const pm=document.getElementById('dailyPrintMeta'); if(pm)pm.textContent=`التاريخ: ${display}`;
    const td=document.getElementById('topDateDisplay'); if(td)td.textContent=display;
    const badge=document.getElementById('dailySaveStatus'); if(badge){badge.textContent=state.dailyDirty?'تعديلات غير محفوظة':'تم التحميل';badge.className=state.dailyDirty?'badge badge-warning':'badge badge-info';}
  }catch(e){console.error(e);toast(e.message||'تعذر تحميل الجرد','error');}
}

function renderTransferCell(list,direction){
  if(!list.length)return '';
  return list.map(function(t){
    const cls=t.pending?'transfer-pending':'transfer-approved';
    const action=t.pending&&direction==='in'?`<button class="transfer-approve-btn no-print" onclick="approveTransferAction('${escapeHtml(t.code)}',true)">موافقة</button>`:'';
    const other=direction==='in'?getBranchName(t.from):getBranchName(t.to);
    return `<div class="transfer-status ${cls}" title="${escapeHtml(t.status)}"><span>${fmt(t.qty)}</span><small>${escapeHtml(other)}</small>${t.pending?' <small>معلق</small>':' <small>معتمد</small>'}${action}</div>`;
  }).join('');
}

