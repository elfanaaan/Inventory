function openZenobiaHelp(){const m=document.getElementById('zenobiaHelpModal');if(!m)return;m.classList.remove('hidden');renderZenobiaHelp();setTimeout(()=>{const s=document.getElementById('zenHelpSearch');if(s)s.focus();},20);document.addEventListener('keydown',zenobiaHelpEscape);}
function closeZenobiaHelp(){const m=document.getElementById('zenobiaHelpModal');if(m)m.classList.add('hidden');document.removeEventListener('keydown',zenobiaHelpEscape);}
function zenobiaHelpEscape(e){if(e.key==='Escape')closeZenobiaHelp();}
function renderZenobiaHelp(){const host=document.getElementById('zenHelpResults');if(!host)return;const q=(document.getElementById('zenHelpSearch')?.value||'').trim().toLocaleLowerCase('ar');const cat=document.getElementById('zenHelpCategory')?.value||'الكل';const list=ZENOBIA_HELP_ARTICLES.filter(a=>(cat==='الكل'||a.category===cat)&&(!q||(a.title+' '+a.keywords+' '+a.body+' '+a.category).toLocaleLowerCase('ar').includes(q)));if(!list.length){host.innerHTML='<div class="zen-help-empty"><strong>لم نعثر على إجابة مطابقة.</strong><p>جرّب كلمات أبسط، أو أرسل للمسؤول تفاصيل التاريخ والفرع والصنف والعمود.</p></div>';return;}host.innerHTML=list.map((a,i)=>'<article class="zen-help-article"><div class="zen-help-meta">'+escapeHtml(a.category)+'</div><h3>'+escapeHtml(a.title)+'</h3><p>'+escapeHtml(a.body)+'</p></article>').join('');}


/* ZANOBIA hospitality input prerequisite enforcement */
(function(){
 function sync(tr){
  if(!tr)return;
  const q=tr.querySelector('.daily-hospitality');if(!q)return;
  const by=(tr.querySelector('.daily-hospitality-by')?.value||'').trim();
  const to=(tr.querySelector('.daily-hospitality-to')?.value||'').trim();
  q.disabled=!(by&&to);
  q.title=q.disabled?'اكتب «بأمر من» و«لمن» أولًا لتفعيل كمية الضيافة':'';
 }
 document.addEventListener('input',function(e){
  if(e.target.matches('.daily-hospitality-by,.daily-hospitality-to,.daily-hospitality'))sync(e.target.closest('tr'));
 },true);
 document.addEventListener('focusin',function(e){
  if(e.target.matches('.daily-hospitality'))sync(e.target.closest('tr'));
 },true);
 document.addEventListener('DOMContentLoaded',function(){
  const body=document.getElementById('dailyTableBody');if(!body)return;
  const scan=()=>body.querySelectorAll('tr[data-item-code]').forEach(sync);
  new MutationObserver(scan).observe(body,{childList:true});scan();
 });
})();
</script>


