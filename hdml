  function dateKeyClient(value){
    if(value===null||value===undefined||value==="") return "";
    const raw=String(value).trim();
    // تاريخ بلا وقت: احتفظ باليوم المكتوب كما هو. أما ISO الذي يحتوي وقتًا
    // (مثل 2026-10-13T21:00:00.000Z) فيجب تحويله للتاريخ المحلي أولًا؛
    // أخذ أول 10 أحرف منه قد ينقل تحويل مصر إلى اليوم السابق.
    const dateOnly=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if(dateOnly) return `${dateOnly[1]}-${dateOnly[2]}-${dateOnly[3]}`;
    const ymd=raw.match(/(\d{4})[\/.-](\d{1,2})[\/.-](\d{1,2})/);
    if(ymd && !/T\d{2}:/.test(raw)) return `${ymd[1]}-${String(ymd[2]).padStart(2,"0")}-${String(ymd[3]).padStart(2,"0")}`;
    const d=new Date(value);
    if(!isNaN(d.getTime())) return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
    return ymd ? `${ymd[1]}-${String(ymd[2]).padStart(2,"0")}-${String(ymd[3]).padStart(2,"0")}` : raw.substring(0,10);
  }

