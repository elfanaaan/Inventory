  function prepareDailyReview() {
    const today = new Date();
    const localDate = new Date(today.getTime() - today.getTimezoneOffset()*60000).toISOString().slice(0,10);
    const from = document.getElementById("reviewFrom"), to = document.getElementById("reviewTo");
    if (from && !from.value) from.value = localDate;
    if (to && !to.value) to.value = localDate;
    const branch = document.getElementById("reviewBranch");
    if (branch && !branch.value && state.branches.length === 1) branch.value = branchCode(state.branches[0]);
    fillBranchSelects();
  }

  async function loadDailyReview() {
    const fromDate = document.getElementById("reviewFrom")?.value || "";
    const toDate = document.getElementById("reviewTo")?.value || "";
    const branchCodeValue = document.getElementById("reviewBranch")?.value || "";
    const body = document.getElementById("reviewBody"), foot = document.getElementById("reviewFoot");
    if (!fromDate || !toDate) { toast("اختر تاريخ البداية والنهاية", "warning"); return; }
    if (toDate < fromDate) { toast("تاريخ النهاية يجب ألا يسبق تاريخ البداية", "warning"); return; }
    if (!branchCodeValue) { toast("اختر الفرع المطلوب مراجعته", "warning"); return; }
    if (body) body.innerHTML = '<tr><td colspan="6">جارٍ تحميل المراجعة...</td></tr>';
    if (foot) foot.innerHTML = "";
    try {
      const result = await server("getDailyReview", {fromDate:fromDate,toDate:toDate,branchCode:branchCodeValue}, state.token);
      const rows = normalizeRows(result?.rows || result);
      const totals = {received:0,returnsQty:0,hospitality:0,transferIn:0,transferOut:0};
      rows.forEach(function(r){Object.keys(totals).forEach(function(k){totals[k]+=num(r[k]);});});
      if (!body) return;
      if (!rows.length) body.innerHTML = '<tr><td colspan="6">لا توجد بيانات في الفترة المحددة</td></tr>';
      else body.innerHTML = rows.map(function(r){return `<tr><td>${escapeHtml(typeof formatArabicDate === "function" ? formatArabicDate(r.date||"") : (r.date||""))}</td><td>${fmt(r.received)}</td><td>${fmt(r.returnsQty)}</td><td>${fmt(r.hospitality)}</td><td>${fmt(r.transferIn)}</td><td>${fmt(r.transferOut)}</td></tr>`;}).join("");
      if (foot) foot.innerHTML = rows.length ? `<tr class="total-row"><th>إجمالي الفترة</th><th>${fmt(totals.received)}</th><th>${fmt(totals.returnsQty)}</th><th>${fmt(totals.hospitality)}</th><th>${fmt(totals.transferIn)}</th><th>${fmt(totals.transferOut)}</th></tr>` : "";
      const branchNameValue = getBranchName(branchCodeValue);
      const info = document.getElementById("reviewInfo"); if(info) info.textContent = `${branchNameValue} — من ${fromDate} إلى ${toDate}`;
    } catch (error) {
      console.error("تعذر تحميل مراجعة الجرد اليومية:", error);
      if (body) body.innerHTML = `<tr><td colspan="6">${escapeHtml(error.message || "تعذر تحميل المراجعة")}</td></tr>`;
      toast(error.message || "تعذر تحميل المراجعة", "error");
    }
  }

