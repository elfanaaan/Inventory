  async function loadItems() {

    try {
      // مزامنة الكتالوج المعتمد تلقائيًا في أول تحميل لإدارة الأصناف بعد دخول المدير؛
      // لا نعتمد على تذكّر الضغط على زر المزامنة يدويًا.
      if (isManager() && !state.approvedCatalogSyncAttempted && state.token) {
        state.approvedCatalogSyncAttempted = true;
        try {
          const syncResult = await server("syncApprovedItemCatalog", state.token);
          if (!syncResult || syncResult.success !== true) {
            state.approvedCatalogSyncAttempted = false;
            throw new Error(syncResult && syncResult.message ? syncResult.message : "لم يؤكد الخادم مزامنة قائمة الأصناف.");
          }
          state.approvedCatalogSyncDone = true;
        } catch (syncError) {
          console.error("تعذرت مزامنة كتالوج الأصناف المعتمد:", syncError);
          toast("تعذرت مزامنة قائمة الأصناف المعتمدة تلقائيًا. استخدم زر المزامنة في صفحة التصنيفات. " + (syncError.message || ""), "warning");
        }
      }

      const result =
        await server(
          "getItems"
        );


      const loadedItems = normalizeRows(result).map(function(item,index){
        if (Array.isArray(item)) return {code:item[0],name:item[1],unit:item[2],category:item[3],displayOrder:item[4],status:item[5]||"نشط",createdAt:item[6],rowNumber:index+2,_sourceOrder:index+1};
        if (item && typeof item === "object") return {
          _sourceOrder:index+1,
          code:item.code ?? item.itemCode ?? item.item_id ?? item["كود الصنف"] ?? item["كود المنتج"] ?? "",
          name:item.name ?? item.itemName ?? item.item_name ?? item["اسم الصنف"] ?? item["اسم المنتج"] ?? item["الصنف"] ?? "",
          unit:item.unit ?? item["الوحدة"] ?? item["وحدة القياس"] ?? "",
          category:item.category ?? item["التصنيف"] ?? item["الفئة"] ?? "",
          displayOrder:item.displayOrder ?? item.order ?? item["ترتيب العرض"] ?? item["ترتيب الصنف"] ?? "",
          status:isActiveItemStatus(item.status ?? item["الحالة"] ?? "نشط") ? "نشط" : "غير نشط",
          createdAt:item.createdAt ?? item["تاريخ الإنشاء"] ?? "",
          rowNumber:Number(item.rowNumber ?? item.row_number ?? item["رقم الصف"] ?? index+2)
        };
        return null;
      }).filter(function(item){ return item && (itemCode(item) || itemName(item)); });
      loadedItems.sort(function(a,b){
        const ao=Number(getRowValue(a,"displayOrder","ترتيب العرض","order"));
        const bo=Number(getRowValue(b,"displayOrder","ترتيب العرض","order"));
        return (ao>0?ao:1000000+(a._sourceOrder||0))-(bo>0?bo:1000000+(b._sourceOrder||0));
      });
      state.items = isManager() ? loadedItems : loadedItems.filter(item => {
        return isActiveItemStatus(getRowValue(item,"status","الحالة") || "نشط");
      });
      if (isManager()) {
        try {
          const categoryResult = await server("getCategories", state.token);
          state.categories = normalizeRows(categoryResult).map(function(c,index){
            if (Array.isArray(c)) return {name:c[0],displayOrder:c[1]||index+1,notes:c[3]||""};
            return {name:c.name ?? c.category ?? c["اسم التصنيف"] ?? "",displayOrder:c.displayOrder ?? c.order ?? c["ترتيب العرض"] ?? index+1,notes:c.notes ?? c["ملاحظات"] ?? ""};
          }).filter(function(c){return !!String(c.name||"").trim();});
        } catch(categoryError) { console.warn("تعذر تحميل التصنيفات الإدارية:",categoryError); }
      }
      // لا نضيف تصنيفًا افتراضيًا للأصناف ذات التصنيف الفارغ؛ تبقى بلا تصنيف حتى يختار المدير تصنيفًا لها.

      fillItemSelect();
      fillAnalysisSelectors();
      refreshAllAdminDropdowns();
      renderCategorySplitTool();
      // قوائم الأصناف قد تصل بعد تحميل لوحة الإدارة؛ أعد بناء المقارنة بعد وصول البيانات.
      if (isManager() && state.currentPage === "dashboard" && !window.__dashboardReloadAfterItems) {
        window.__dashboardReloadAfterItems = true;
        Promise.resolve().then(() => loadDashboard()).finally(() => { window.__dashboardReloadAfterItems = false; });
      }

      const tbody =
        document.getElementById(
          "itemsBody"
        );


      if (!tbody) return;
      renderItemsTable();

    } catch (error) {

      toast(
        error.message ||
        "تعذر تحميل الأصناف",
        "error"
      );

    }

  }


  // التصنيفات المُدارة هي المرجع الأول، مع إبقاء أي تصنيف مستخدم قديم ظاهرًا لحماية بيانات الأصناف.
  const STANDARD_ITEM_CATEGORIES = [];

  // مفتاح موحد للمقارنة فقط؛ لا يغيّر الاسم الأصلي المخزن أو المعروض.
  function categoryOrderKey(value) {
    return String(value == null ? "" : value)
      .normalize("NFC")
      .replace(/[\u064B-\u065F\u0670\u0640]/g, "")
      .replace(/[\u0622\u0623\u0625\u0671]/g, "ا")
      .replace(/[\u0649]/g, "ي")
      .replace(/\s+/g, " ")
      .trim();
  }

  function getAvailableItemCategories() {
    const managed = (Array.isArray(state.categories) ? state.categories : [])
      .slice()
      .sort((a,b) => (Number(a.displayOrder)||999999)-(Number(b.displayOrder)||999999))
      .map(c => String(c.name || c.category || "").trim()).filter(Boolean);
    const existing = (Array.isArray(state.items) ? state.items : [])
      .map(item => String(itemCategory(item) || "").trim()).filter(Boolean);
    const ordered = [...new Set(managed.concat(STANDARD_ITEM_CATEGORIES))];
    const seenKeys = new Set(ordered.map(categoryOrderKey));
    existing.forEach(function(name){const key=categoryOrderKey(name);if(key&&!seenKeys.has(key)){ordered.push(name);seenKeys.add(key);}});
    // الأصناف ذات التصنيف الفارغ لا تنشئ مجموعة أو اسم تصنيف تلقائيًا.
    return ordered;
  }

