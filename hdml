  function updateDailyRow(
    element
  ) {

    const tr =
      element.closest("tr");


    if (!tr) {
      return;
    }


    const row =
      state.dailyRows.find(
        r =>
          String(
            getRowValue(
              r,
              "itemCode",
              "كود الصنف"
            )
          ) ===
          String(
            tr.dataset.itemCode
          )
      );


    if (!row) {
      return;
    }


    const openingInput = tr.querySelector(".daily-opening");
    const opening = openingInput ? num(openingInput.value) : num(getRowValue(row,"opening","openingBalance"));


    const received =
      num(
        tr.querySelector(
          ".daily-received"
        )?.value
      );


    const returnsQty =
      num(
        tr.querySelector(
          ".daily-returns"
        )?.value
      );


    const hospitality =
      num(
        tr.querySelector(
          ".daily-hospitality"
        )?.value
      );


    const transferIn =
      num(
        getRowValue(
          row,
          "transferIn"
        )
      );


    const transferOut =
      num(
        getRowValue(
          row,
          "transferOut"
        )
      );


    const sold =
      num(
        tr.querySelector(
          ".daily-sold"
        )?.value
      );


    const expected =
      opening +
      received -
      returnsQty -
      hospitality +
      transferIn -
      transferOut;
    const ending = expected - sold;


    const actualInput =
      tr.querySelector(
        ".daily-actual"
      );


    const actual =
      actualInput &&
      actualInput.value !== ""
        ? Number(
            actualInput.value
          )
        : null;


    const difference =
      actual === null
        ? null
        : actual - ending;


    const expectedCell =
      tr.querySelector(
        ".expected-cell"
      );


    const differenceCell =
      tr.querySelector(
        ".difference-cell"
      );


    const endingCell =
      tr.querySelector(
        ".ending-cell"
      );


    if (expectedCell) {

      expectedCell.textContent =
        fmt(expected);

    }


    if (endingCell) {

      endingCell.textContent = fmt(ending);

    }


        if (differenceCell) {
      differenceCell.textContent =
        difference === null
          ? ""
          : fmt(difference);

      differenceCell.className =
        "readonly-number difference-cell " +
        (
          difference === null
            ? ""
            : difference > 0
              ? "positive"
              : difference < 0
                ? "negative"
                : "zero"
        );
    }

    markDailyDirty();
  }


  async function saveDailyInventory(silent=false){
    if(!state.dailyRows.length){if(!silent)toast("لا توجد بيانات للحفظ","warning");return false;}
    const date=document.getElementById("dailyDate")?.value,branch=getDailyBranchCode();
    if(!date||!branch){if(!silent)toast("يجب تحديد التاريخ والفرع","warning");return false;}
    const isSystemManager=["مدير النظام","مدير","admin","ADMIN"].includes(String(state.user?.role||"")),rows=[];
    document.querySelectorAll("#dailyTableBody tr[data-item-code]").forEach(tr=>{
      const openingInput=tr.querySelector(".daily-opening");
    const openingShouldSave=!!(isSystemManager&&openingInput&&(openingInput.dataset.openingManual==="1"||openingInput.dataset.openingEdited==="1"));
    rows.push({itemCode:tr.dataset.itemCode,opening:openingShouldSave?num(openingInput.value):null,received:num(tr.querySelector(".daily-received")?.value),returnsQty:num(tr.querySelector(".daily-returns")?.value),hospitality:num(tr.querySelector(".daily-hospitality")?.value),sold:num(tr.querySelector(".daily-sold")?.value),actual:tr.querySelector(".daily-actual")?.value===""?null:Number(tr.querySelector(".daily-actual")?.value),notes:tr.querySelector(".daily-notes")?.value||""});
    });
    try{
      const result=await server("saveDailyInventoryBatch",{date,branchCode:branch,submittedBy:state.user?.userName||state.user?.username||"",items:rows,rows},state.token);
      if(!result||result.success!==false){state.dailyDirty=false;const b=document.getElementById("dailySaveStatus");if(b){b.textContent="تم الحفظ";b.className="badge badge-success";}if(!silent)toast(result?.message||"تم حفظ الجرد بنجاح","success");return true;}
      if(!silent)toast(result.message||"تعذر حفظ الجرد","error");return false;
    }catch(e){if(!silent)toast(e.message||"حدث خطأ أثناء حفظ الجرد","error");return false;}
  }
  function markDailyDirty(){
    state.dailyDirty=true;
    const b=document.getElementById("dailySaveStatus");if(b){b.textContent="تعديلات غير محفوظة — سيتم الحفظ تلقائيًا خلال 10 ثوانٍ";b.className="badge badge-warning";}
    clearTimeout(window.__dailyAutosaveTimer);
    window.__dailyAutosaveTimer=setTimeout(async()=>{if(state.dailyDirty&&!window.__autosaving){window.__autosaving=true;try{await saveDailyInventory(true);}finally{window.__autosaving=false;} }},10000);
  }
  function startAutosave(){window.__dailyAutosaveStarted=true;}

  async function createRowTransfer(button,itemCode){
    const tr=button?.closest("tr");if(!tr)return;
    const to=tr.querySelector(".transfer-to-select")?.value||"",qty=Number(tr.querySelector(".transfer-out-qty")?.value||0),date=document.getElementById("dailyDate")?.value||"",from=getDailyBranchCode();
    if(!from||!to||qty<=0){toast("اكتب الكمية واختر الفرع المحول إليه","warning");return;}
    if(from===to){toast("لا يمكن التحويل إلى نفس الفرع","warning");return;}
    const item=state.items.find(it=>String(itemCodeOf(it))===String(itemCode));
    if(itemUnit(item)==="كيلو"&&!Number.isInteger(qty*1000)){toast("كمية الكيلو يجب أن تكون حتى 3 منازل عشرية","warning");return;}
    button.disabled=true;
    try{
      const result=await server("createTransfer",{fromBranch:from,toBranch:to,itemCode,quantity:qty,requestedBy:state.user?.userName||state.user?.username||"",transferType:"فرع → فرع",reason:"تحويل من صف الصنف",date},state.token);
      if(result&&result.success===false)throw new Error(result.message||"تعذر إنشاء التحويل");
      // لا تعيد تحميل الجرد بعد التحويل. إعادة التحميل كانت سبب اختفاء قائمة الأصناف.
      state.dailyTransfers=Array.isArray(state.dailyTransfers)?state.dailyTransfers:[];
      if(result && result.transferCode){
        state.dailyTransfers.push({transferCode:result.transferCode,date:date,fromBranch:from,toBranch:to,itemCode:itemCode,quantity:qty,status:"قيد الانتظار",requestedBy:state.user?.userName||state.user?.username||""});
      }
      toast("تم إرسال التحويل. سيظهر بالأحمر حتى موافقة الفرع المستلم.","success");
      tr.querySelector(".transfer-out-qty").value="";
      const info=dailyTransferInfo(itemCode);
      const outCell=tr.querySelector(".col-transfer-out");
      const partyCell=outCell?outCell.nextElementSibling:null;
      const row=state.dailyRows.find(r=>String(getRowValue(r,"itemCode","كود الصنف"))===String(itemCode));
      const unit=getRowValue(row||{},"unit","الوحدة")||itemUnit(state.items.find(it=>String(itemCodeOf(it))===String(itemCode)));
      if(outCell) outCell.innerHTML=renderOutgoingTransferControls(itemCode,unit,from,info.outgoing);
      if(partyCell) partyCell.textContent=info.outNames||info.outgoing.map(t=>getBranchName(t.to)).join("، ");
      // التحويل المعلق لا يخصم من الرصيد ولا يغيّر أسماء الأصناف.
    }catch(e){toast(e.message||"تعذر إنشاء التحويل","error");}finally{button.disabled=false;}
  }


