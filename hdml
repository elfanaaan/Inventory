<script id="excel-match-client">
/* مطابقة Excel: الملف يُقرأ محليًا في المتصفح، ولا يُرفع إلى Google Drive. */
(function(){
  const MATCH_METRICS = [
    {key:'received', label:'المستلم'},
    {key:'returnsQty', label:'المرتجع'},
    {key:'transferIn', label:'التحويل الوارد'},
    {key:'transferOut', label:'التحويل المنصرف'},
    {key:'hospitality', label:'الضيافة'}
  ];
  const SHEETJS_URL = 'https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';
  let matchState = { fileName:'', sheets:[], branchOptions:[], allRows:[], resultRows:[], lastSummary:null };

  function node(id){return document.getElementById(id);}
  function normalizeName(value){
    return String(value == null ? '' : value).toLowerCase()
      .replace(/[\u064B-\u065F\u0670\u0640]/g,'')
      .replace(/[أإآٱ]/g,'ا').replace(/[ىي]/g,'ي').replace(/ة/g,'ه')
      .replace(/[^a-z0-9\u0600-\u06FF]/g,'');
  }
  function localDateKey(y,m,d){return String(y).padStart(4,'0')+'-'+String(m).padStart(2,'0')+'-'+String(d).padStart(2,'0');}
  function parseDateCell(cell){
    if(!cell) return '';
    const raw = cell.w != null && String(cell.w).trim() ? String(cell.w).trim() : cell.v;
    if(raw instanceof Date && !isNaN(raw.getTime())) return localDateKey(raw.getFullYear(),raw.getMonth()+1,raw.getDate());
    const s = String(raw == null ? '' : raw).trim();
    let m = s.match(/(\d{4})\s*[\/.-]\s*(\d{1,2})\s*[\/.-]\s*(\d{1,2})/);
    if(m) return localDateKey(Number(m[1]),Number(m[2]),Number(m[3]));
    m = s.match(/(?:^|\D)(\d{1,2})\s*[\/.-]\s*(\d{1,2})\s*[\/.-]\s*(\d{4})(?:\D|$)/);
    if(m) return localDateKey(Number(m[3]),Number(m[2]),Number(m[1]));
    if(typeof cell.v === 'number' && window.XLSX && XLSX.SSF && XLSX.SSF.parse_date_code){
      const d = XLSX.SSF.parse_date_code(cell.v);
      if(d && d.y && d.m && d.d) return localDateKey(d.y,d.m,d.d);
    }
    return '';
  }
  function arabicNumberString(s){
    const arabic='٠١٢٣٤٥٦٧٨٩', persian='۰۱۲۳۴۵۶۷۸۹';
    return String(s).replace(/[٠-٩]/g,ch=>String(arabic.indexOf(ch)))
      .replace(/[۰-۹]/g,ch=>String(persian.indexOf(ch)))
      .replace(/٫/g,'.').replace(/[٬،]/g,',');
  }
  function numberFromCell(sheet,row,col,sheetName,label){
    const address=XLSX.utils.encode_cell({r:row,c:col});
    const cell=sheet[address];
    if(!cell) return 0;
    if(cell.f && (cell.v === undefined || cell.v === null || cell.v === '')){
      throw new Error('خلية الإجمالي '+address+' في ورقة «'+sheetName+'» تحتوي معادلة بلا قيمة محفوظة. افتح الملف في Excel واحفظه ثم أعد المحاولة.');
    }
    if(cell.v === undefined || cell.v === null || cell.v === '') return 0;
    if(typeof cell.v === 'number') return Number.isFinite(cell.v) ? cell.v : 0;
    if(cell.v instanceof Date) throw new Error('وجد تاريخ بدل كمية في الخلية '+address+' بورقة «'+sheetName+'».');
    let raw=arabicNumberString(cell.v).trim();
    if(!raw || ['-','—','–'].includes(raw)) return 0;
    raw=raw.replace(/,/g,'').replace(/\s/g,'');
    const n=Number(raw);
    if(!Number.isFinite(n)) throw new Error('تعذر قراءة كمية «'+label+'» في الخلية '+address+' بورقة «'+sheetName+'»: '+String(cell.v));
    return n;
  }
  function monthPeriod(dates){
    const count={};
    dates.forEach(d=>{const key=d.slice(0,7);count[key]=(count[key]||0)+1;});
    let selected='';
    Object.keys(count).forEach(k=>{if(!selected || count[k]>count[selected]) selected=k;});
    const inMonth=dates.filter(d=>d.slice(0,7)===selected).sort();
    return {from:inMonth[0]||dates.slice().sort()[0]||'',to:inMonth[inMonth.length-1]||dates.slice().sort().slice(-1)[0]||''};
  }
  function getSheetBranchStem(sheetName){
    let stem=String(sheetName).replace(/^\s*مستلم\s*/,'').trim();
    if(/masrer/i.test(stem)) return 'مدينة نصر';
    return stem.replace(/^فرع\s+/,'').trim();
  }
  function suggestedBranchCode(sheetName,branches){
    const stem=getSheetBranchStem(sheetName), target=normalizeName(stem);
    let matches=branches.filter(b=>normalizeName(b.name)===target);
    if(matches.length===1) return matches[0].code;
    const partial=branches.filter(b=>{
      const n=normalizeName(b.name);
      return n.length>=5 && (target.indexOf(n)>=0 || n.indexOf(target)>=0);
    });
    return partial.length===1 ? partial[0].code : '';
  }
  function extractSheetTotals(sheetName,sheet){
    if(!sheet || !sheet['!ref']) throw new Error('ورقة «'+sheetName+'» ليس لها نطاق خلايا مقروء.');
    const range=XLSX.utils.decode_range(sheet['!ref']);
    if(range.e.r < 431 || range.e.c < 9) throw new Error('ورقة «'+sheetName+'» لا تحتوي على صف الإجمالي اليومي رقم 432 أو الأعمدة المطلوبة.');
    const days=[];
    // يتكرر كل يوم في 10 أعمدة بدءًا من D: D/E/F/H/J فقط هي الحركات المطلوبة.
    // لا تتم قراءة G وI (وصف جهة التحويل) ولا K/M وما بعدها (المبيعات/السعر/القيمة).
    const movementOffsets=[0,1,2,4,6];
    for(let startCol=3; startCol<=range.e.c; startCol+=10){
      const dateCell=sheet[XLSX.utils.encode_cell({r:2,c:startCol})];
      const date=parseDateCell(dateCell);
      if(!date){ if(days.length) break; continue; }
      const values={date:date};
      MATCH_METRICS.forEach((metric,i)=>{
        values[metric.key]=numberFromCell(sheet,431,startCol+movementOffsets[i],sheetName,metric.label);
      });
      days.push(values);
    }
    if(!days.length) throw new Error('لم أجد تواريخ الأيام في الصف الثالث بورقة «'+sheetName+'» بدءًا من العمود D.');
    const seen={};
    days.forEach(d=>{if(seen[d.date]) throw new Error('تاريخ مكرر '+d.date+' بورقة «'+sheetName+'».');seen[d.date]=true;});
    return days;
  }
  async function ensureSheetJs(){
    if(window.XLSX && window.XLSX.read) return;
    if(window.__zenobiaSheetJsPromise) return window.__zenobiaSheetJsPromise;
    window.__zenobiaSheetJsPromise=new Promise((resolve,reject)=>{
      const s=document.createElement('script');
      s.src=SHEETJS_URL; s.async=true; s.id='zenobia-sheetjs-runtime';
      s.onload=()=>window.XLSX && window.XLSX.read ? resolve() : reject(new Error('تم تحميل المكتبة لكن لم تتوفر أدوات قراءة Excel.'));
      s.onerror=()=>reject(new Error('تعذر تحميل مكتبة قراءة Excel الرسمية. تحقق من اتصال الإنترنت ثم أعد المحاولة.'));
      document.head.appendChild(s);
    });
    return window.__zenobiaSheetJsPromise;
  }
  function setStatus(message,kind){
    const el=node('excelMatchStatus'); if(!el)return;
    el.className='excelmatch-status'+(kind?' '+kind:''); el.textContent=message;
  }
  function branchList(){
    if(Array.isArray(matchState.branchOptions) && matchState.branchOptions.length) return matchState.branchOptions.filter(b=>b && b.code && b.name);
    return (typeof state !== 'undefined' && Array.isArray(state.branches)) ? state.branches.filter(b=>b && b.code && b.name) : [];
  }
  function renderMapping(){
    const wrap=node('excelMatchMappingWrap'), body=node('excelMatchMappingBody');
    if(!wrap||!body)return;
    const branches=branchList();
    body.innerHTML=matchState.sheets.map((sheet,i)=>{
      const options=['<option value="">— اختر الفرع —</option>'].concat(branches.map(b=>'<option value="'+escapeHtml(String(b.code))+'" '+(String(sheet.branchCode)===String(b.code)?'selected':'')+'>'+escapeHtml(b.name)+' ('+escapeHtml(b.code)+')'+(String(b.status||'نشط')==='نشط'?'':' — '+escapeHtml(b.status||'غير نشط'))+'</option>'));
      return '<tr><td>'+(i+1)+'</td><td>'+escapeHtml(sheet.name)+'</td><td>'+sheet.days.length+'</td><td><select class="form-control excelmatch-map-select" data-index="'+i+'">'+options.join('')+'</select></td><td><label><input type="checkbox" class="excelmatch-exclude" data-index="'+i+'" '+(sheet.excluded?'checked':'')+'> استبعاد</label></td></tr>';
    }).join('');
    body.querySelectorAll('.excelmatch-map-select').forEach(sel=>sel.addEventListener('change',()=>{
      const i=Number(sel.dataset.index); if(matchState.sheets[i]) matchState.sheets[i].branchCode=sel.value;
      if(matchState.sheets[i] && sel.value) {
        matchState.sheets[i].excluded=false;
        const cb=body.querySelector('.excelmatch-exclude[data-index=\"'+i+'\"]'); if(cb) cb.checked=false;
      }
      renderMappingSummary();
    }));
    body.querySelectorAll('.excelmatch-exclude').forEach(cb=>cb.addEventListener('change',()=>{
      const i=Number(cb.dataset.index); if(matchState.sheets[i]) matchState.sheets[i].excluded=cb.checked;
      if(cb.checked){const select=body.querySelector('.excelmatch-map-select[data-index="'+i+'"]');if(select){select.value='';if(matchState.sheets[i])matchState.sheets[i].branchCode='';}}
      renderMappingSummary();
    }));
    wrap.classList.remove('hidden');
    renderMappingSummary();
  }
  function renderMappingSummary(){
    const branches=branchList();
    const included=matchState.sheets.filter(s=>!s.excluded);
    const missing=included.filter(s=>!s.branchCode);
    const codes=included.map(s=>s.branchCode).filter(Boolean);
    const duplicated=codes.filter((c,i)=>codes.indexOf(c)!==i);
    const uniqueDuplicate=[...new Set(duplicated)];
    const summary=node('excelMatchMappingSummary');
    if(summary){
      let msg='أوراق الفروع: '+matchState.sheets.length+'؛ أوراق مربوطة: '+included.filter(s=>s.branchCode).length+'؛ مستبعدة باختيارك: '+matchState.sheets.filter(s=>s.excluded).length+'.';
      if(missing.length) msg+=' يلزم ربط '+missing.length+' ورقة قبل المطابقة.';
      if(uniqueDuplicate.length) msg+=' يوجد ربط مكرر للأفرع: '+uniqueDuplicate.map(c=>{const b=branches.find(x=>String(x.code)===String(c));return b?b.name:c;}).join('، ')+'.';
      summary.textContent=msg;
      summary.className='excelmatch-muted'+((missing.length||uniqueDuplicate.length)?' excelmatch-map-warning':'');
    }
    const btn=node('excelMatchRunBtn'); if(btn) btn.disabled=!matchState.sheets.length||missing.length>0||uniqueDuplicate.length>0||!included.length;
  }
  function extractRangeRows(){
    const from=node('excelMatchFromDate').value, to=node('excelMatchToDate').value;
    if(!from||!to) throw new Error('اختر تاريخ البداية والنهاية.');
    if(from>to) throw new Error('تاريخ البداية يجب أن يكون قبل تاريخ النهاية أو مساويًا له.');
    const included=matchState.sheets.filter(s=>!s.excluded);
    if(!included.length) throw new Error('لا توجد أوراق فروع مشمولة في المطابقة.');
    const byDate={};
    included.forEach(sheet=>{
      const found={};
      sheet.days.forEach(d=>{if(d.date>=from&&d.date<=to) found[d.date]=d;});
      const dates=Object.keys(found).sort();
      if(!dates.length) throw new Error('لا توجد أيام داخل الفترة المختارة في الورقة «'+sheet.name+'».');
      dates.forEach(date=>{
        byDate[date]=true;
        // Keep actual Excel aggregates as found; no selling/sales, price or financial values are copied.
      });
    });
    const expectedDates=Object.keys(byDate).sort();
    const expectedDateSet={}; expectedDates.forEach(d=>expectedDateSet[d]=true);
    const rows=[];
    included.forEach(sheet=>{
      const map={}; sheet.days.forEach(d=>{if(d.date>=from&&d.date<=to)map[d.date]=d;});
      expectedDates.forEach(date=>{
        const excel=map[date];
        if(!excel) throw new Error('التاريخ '+date+' غير موجود في ورقة «'+sheet.name+'». لم تتم المطابقة حتى لا نعتبر اليوم الناقص صفرًا.');
        rows.push({branchCode:String(sheet.branchCode),branchName:(branchList().find(b=>String(b.code)===String(sheet.branchCode))||{}).name||getSheetBranchStem(sheet.name),sheetName:sheet.name,date:date,excel:excel});
      });
    });
    if(rows.length>3000) throw new Error('عدد الفروع والأيام في هذه الفترة كبير جدًا. اختر فترة أقصر.');
    return rows;
  }
  function roundQty(v){return Math.round((Number(v)||0)*1000)/1000;}
  function prettyQty(v){return Number(v||0).toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:3});}
  function renderResults(){
    const body=node('excelMatchResultsBody'), card=node('excelMatchResultsCard');
    if(!body||!card)return;
    const showAll=!!(node('excelMatchShowAll')&&node('excelMatchShowAll').checked);
    const displayed=showAll?matchState.resultRows:matchState.resultRows.filter(r=>r.status!=='match');
    if(!displayed.length){
      body.innerHTML='<tr><td colspan="8">'+(matchState.resultRows.length?'لا توجد فروق في الإجماليات اليومية للفترة المحددة.':'لا توجد نتائج لعرضها.')+'</td></tr>';
    } else {
      body.innerHTML=displayed.map((r,i)=>{
        const rowClass=r.status==='missing'?'excelmatch-missing':r.status==='different'?'excelmatch-different':'excelmatch-match';
        const pillClass=r.status==='missing'?'missing':r.status==='different'?'different':'match';
        const badge=r.status==='missing'?'لا توجد بيانات جرد':r.status==='different'?'يوجد فرق':'متطابق';
        return '<tr class="'+rowClass+'"><td>'+escapeHtml(r.branchName)+'</td><td class="excelmatch-num">'+escapeHtml(r.date)+'</td><td>'+escapeHtml(r.metricLabel)+'</td><td class="excelmatch-num">'+escapeHtml(r.excelText)+'</td><td class="excelmatch-num">'+escapeHtml(r.systemText)+'</td><td class="excelmatch-num">'+escapeHtml(r.diffText)+'</td><td><span class="excelmatch-pill '+pillClass+'">'+badge+'</span></td><td>'+(r.status==='missing'?'—':'<button type="button" class="btn btn-light excelmatch-open-day" data-review="'+i+'">مراجعة اليوم</button>')+'</td></tr>';
      }).join('');
      body.querySelectorAll('[data-review]').forEach(btn=>btn.addEventListener('click',()=>{
        const item=displayed[Number(btn.dataset.review)]; if(item) openDailyReview(item.branchCode,item.date);
      }));
    }
    card.classList.remove('hidden');
    const note=node('excelMatchResultNote');
    if(note && matchState.lastSummary){
      note.textContent='تاريخ الفحص: '+matchState.lastSummary.checkedAt+' — تمت مقارنة خمسة أنواع حركة فقط. الفرق = قيمة Excel ناقص قيمة نظام الجرد. أي يوم بلا سجلات محفوظة يظهر كتحذير ولا يُعامل على أنه متطابق.';
    }
  }
  function openDailyReview(branchCode,date){
    const branchField=node('dailyBranch');
    if(branchField){
      const exists=Array.from(branchField.options||[]).some(o=>String(o.value)===String(branchCode));
      if(!exists){toast('هذا الفرع غير ظاهر في قائمة الجرد التشغيلي الحالية. يمكنك مراجعة نتيجة المطابقة، لكن لا يمكن فتح شاشة الجرد له بحالته الحالية.','warning');return;}
      branchField.value=branchCode;
    }
    const dateField=node('dailyDate'); if(dateField) dateField.value=date;
    showPage('daily');
  }
  function showSummary(systemTotals){
    const systemMap={}; systemTotals.forEach(r=>systemMap[r.date+'|'+r.branchCode]=r);
    const all=[]; const pairStates=[];
    let missingDays=0, diffCells=0;
    const sourceRows=window.__zenobiaExcelMatchRows||[];
    sourceRows.forEach(pair=>{
      const system=systemMap[pair.date+'|'+pair.branchCode];
      if(!system){throw new Error('لم يرجع نظام الجرد بيانات المقارنة للفرع '+pair.branchName+' بتاريخ '+pair.date+'.');}
      if(!system.hasRecords){
        missingDays++;
        all.push({branchCode:pair.branchCode,branchName:pair.branchName,date:pair.date,metricLabel:'بيانات اليوم',excelText:MATCH_METRICS.map(m=>m.label+': '+prettyQty(pair.excel[m.key])).join(' | '),systemText:'—',diffText:'—',status:'missing'});
        pairStates.push({key:pair.branchCode+'|'+pair.date,status:'missing'});
        return;
      }
      let dayHasDifference=false;
      MATCH_METRICS.forEach(m=>{
        const ex=roundQty(pair.excel[m.key]), sys=roundQty(system[m.key]), diff=roundQty(ex-sys);
        const equal=Math.abs(diff)<0.0005;
        if(!equal){dayHasDifference=true;diffCells++;}
        all.push({branchCode:pair.branchCode,branchName:pair.branchName,date:pair.date,metricLabel:m.label,excelText:prettyQty(ex),systemText:prettyQty(sys),diffText:equal?'0':prettyQty(diff),status:equal?'match':'different'});
      });
      pairStates.push({key:pair.branchCode+'|'+pair.date,status:dayHasDifference?'different':'match'});
    });
    const unique={}; pairStates.forEach(p=>unique[p.key]=p.status);
    const statuses=Object.values(unique);
    const summary={checked:sourceRows.length,matched:statuses.filter(s=>s==='match').length,different:statuses.filter(s=>s==='different').length,missing:statuses.filter(s=>s==='missing').length,diffCells:diffCells,checkedAt:systemTotals.length?systemTotals[0].checkedAt||new Date().toLocaleString('ar-EG'):new Date().toLocaleString('ar-EG')};
    matchState.resultRows=all; matchState.lastSummary=summary;
    node('excelMatchSummaryCards').classList.remove('hidden');
    node('excelMatchDaysChecked').textContent=String(summary.checked);
    node('excelMatchDaysMatched').textContent=String(summary.matched);
    node('excelMatchDaysDifferent').textContent=String(summary.different);
    node('excelMatchDaysMissing').textContent=String(summary.missing);
    node('excelMatchShowAll').checked=false;
    renderResults();
  }
  window.initExcelMatchPage=async function(){
    if(!Array.isArray(matchState.branchOptions) || !matchState.branchOptions.length){
      try{
        matchState.branchOptions=normalizeRows(await server('getExcelMatchBranchOptions',state.token)).map(function(b){
          return {code:String(getRowValue(b,'code','كود الفرع')||''),name:String(getRowValue(b,'name','اسم الفرع')||''),status:String(getRowValue(b,'status','الحالة')||'نشط'),entityType:String(getRowValue(b,'entityType','نوع الجهة')||'فرع')};
        }).filter(function(b){return b.code&&b.name;});
      }catch(e){console.error('تعذر تحميل قائمة الفروع لمطابقة Excel',e);setStatus(e.message||'تعذر تحميل قائمة الفروع.', 'error');}
    }
  };
  window.excelMatchHandleFileSelected=async function(event){
    const file=event && event.target && event.target.files && event.target.files[0];
    node('excelMatchRunBtn').disabled=true;
    node('excelMatchMappingWrap').classList.add('hidden');
    node('excelMatchResultsCard').classList.add('hidden');
    node('excelMatchSummaryCards').classList.add('hidden');
    matchState={fileName:'',sheets:[],branchOptions:matchState.branchOptions||[],allRows:[],resultRows:[],lastSummary:null};
    window.__zenobiaExcelMatchRows=[];
    if(!file){setStatus('لم يتم اختيار ملف.', '');return;}
    if(!/\.(xlsb|xlsx|xlsm|xls)$/i.test(file.name)){setStatus('نوع الملف غير مدعوم. اختر ملف Excel بصيغة XLSB أو XLSX.', 'error');return;}
    if(file.size>100*1024*1024){setStatus('حجم الملف أكبر من 100 ميجابايت. اختر ملفًا أصغر أو قسّمه من Excel.', 'error');return;}
    try{
      setStatus('جارٍ تحميل أداة القراءة وقراءة الملف محليًا داخل المتصفح…','');
      await ensureSheetJs();
      const buf=await file.arrayBuffer();
      const workbook=XLSX.read(new Uint8Array(buf),{type:'array',cellDates:true,cellFormula:true});
      const names=workbook.SheetNames.filter(n=>normalizeName(n).startsWith(normalizeName('مستلم')));
      if(!names.length) throw new Error('لم أجد أوراقًا يبدأ اسمها بكلمة «مستلم».');
      await window.initExcelMatchPage();
      if(!Array.isArray(matchState.branchOptions) || !matchState.branchOptions.length) throw new Error('تعذر تحميل قائمة الفروع المسجلة كاملة. أعد فتح صفحة المطابقة وحاول مرة أخرى؛ لم تبدأ أي مقارنة.');
      const branches=branchList();
      const parsed=[];
      names.forEach(name=>{
        const sheet=workbook.Sheets[name];
        const days=extractSheetTotals(name,sheet);
        const code=suggestedBranchCode(name,branchList());
        parsed.push({name:name,days:days,branchCode:code,autoBranchCode:code,excluded:false});
      });
      const allDates=[...new Set(parsed.flatMap(s=>s.days.map(d=>d.date)))].sort();
      if(!allDates.length) throw new Error('لم يتم العثور على تواريخ يومية صالحة.');
      // Workbook bytes and full workbook object are not retained or transmitted.
      matchState={fileName:file.name,sheets:parsed,allRows:[],resultRows:[],lastSummary:null};
      const period=monthPeriod(allDates);
      node('excelMatchFromDate').value=period.from;
      node('excelMatchToDate').value=period.to;
      node('excelMatchFileMeta').textContent=file.name+' — '+(file.size/1024/1024).toFixed(1)+' MB — تمت قراءة '+parsed.length+' ورقة فرع و'+allDates.length+' تاريخًا مختلفًا.';
      renderMapping();
      const unmapped=parsed.filter(s=>!s.branchCode).length;
      setStatus('نجحت القراءة المحلية. الفترة الافتراضية: '+period.from+' إلى '+period.to+'. راجع ربط أوراق الفروع قبل بدء المقارنة. '+(unmapped?'هناك '+unmapped+' ورقة تحتاج إلى ربط يدوي.':'تم اقتراح الربط لجميع الأوراق.'),'success');
      if(window.XLSX) { /* Drop parsed workbook object and byte buffers as early as practical. */ }
    }catch(error){
      console.error('Excel totals extraction failed',error);
      setStatus(error && error.message ? error.message : String(error),'error');
      node('excelMatchFileMeta').textContent='تعذر تحليل الملف. لم تُرسل أي بيانات إلى الخادم.';
      node('excelMatchRunBtn').disabled=true;
    }
  };
  window.excelMatchRunComparison=async function(){
    try{
      if(typeof state !== 'undefined' && state.dailyDirty) throw new Error('توجد تعديلات غير محفوظة في شاشة الجرد اليومي. احفظها أولًا أو اتركها دون تعديل، ثم أعد المطابقة حتى نقارن البيانات المحفوظة في النظام.');
      if(!matchState.sheets.length) throw new Error('اختر ملف Excel واقرأه أولًا.');
      const rows=extractRangeRows();
      const keys=rows.map(r=>({branchCode:r.branchCode,date:r.date}));
      setStatus('تم استخراج إجماليات Excel محليًا. جارٍ جلب إجماليات الجرد المحفوظة للمقارنة…','');
      const response=await server('getExcelMatchSystemTotals',{keys:keys},state.token);
      if(!response || !response.success || !Array.isArray(response.totals)) throw new Error('لم يرجع نظام الجرد بيانات صالحة للمقارنة.');
      response.totals.forEach(r=>{r.checkedAt=response.checkedAt||'';});
      window.__zenobiaExcelMatchRows=rows;
      showSummary(response.totals);
      setStatus('اكتملت المطابقة. عدد الفروع والأيام المفحوصة: '+rows.length+'. راجع الفروق أو الأيام التي لا توجد لها بيانات جرد محفوظة.','success');
      node('excelMatchResultsCard').scrollIntoView({behavior:'smooth',block:'start'});
    }catch(error){
      console.error('Excel totals comparison failed',error);
      setStatus(error && error.message ? error.message : String(error),'error');
    }
  };
  window.excelMatchRenderResults=renderResults;
  window.excelMatchReset=function(){
    const input=node('excelMatchFile'); if(input) input.value='';
    ['excelMatchFromDate','excelMatchToDate'].forEach(id=>{if(node(id))node(id).value='';});
    if(node('excelMatchFileMeta'))node('excelMatchFileMeta').textContent='لم يتم اختيار ملف بعد.';
    if(node('excelMatchMappingWrap'))node('excelMatchMappingWrap').classList.add('hidden');
    if(node('excelMatchResultsCard'))node('excelMatchResultsCard').classList.add('hidden');
    if(node('excelMatchSummaryCards'))node('excelMatchSummaryCards').classList.add('hidden');
    node('excelMatchRunBtn').disabled=true;
    matchState={fileName:'',sheets:[],branchOptions:matchState.branchOptions||[],allRows:[],resultRows:[],lastSummary:null};
    window.__zenobiaExcelMatchRows=[];
    setStatus('تم مسح الاختيار من واجهة المطابقة. لم يتم حفظ الملف أو نسخه.','');
  };
})();
</script>

