function fmt(value){
  const n=Number(value);
  if(!Number.isFinite(n)) return '';
  return n.toLocaleString('en-US',{maximumFractionDigits:3,useGrouping:true});
}

function branchEntityType(branch){ return String(branch?.entityType || branch?.['نوع الجهة'] || branch?.[4] || 'فرع').trim() || 'فرع'; }

function specialEntityName(code){
  if(String(code)==='ADMIN') return 'الإدارة';
  if(String(code)==='FACTORY') return 'المصنع';
  return '';
}

function getBranchName(code){
  const special=specialEntityName(code); if(special)return special;
  const branch=state.branches.find(b=>String(branchCode(b))===String(code));
  return branch?branchName(branch):code;
}

async function handleDailyDateChange(){
